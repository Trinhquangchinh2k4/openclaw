     owner_msgs = extract_owner_messages(body_vi)\n        if owner_msgs:\n            for om in owner_msgs:\n                msgs.append({\n                    'speaker': om['speaker'],\n                    'time': ts,\n                    'text': _simplify_tech_phrase_vi(om['text']),\n                    'detail': detail,\n                    'rag': u.get('rag', 'GREEN')\n                })\n            continue\n\n        preview = summarize_non_technical_vi(body_vi)\n        msgs.append({\n            'speaker': detect_speaker(body_vi),\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n\n    # Bổ sung hiện diện hội thoại cho đủ các bot chủ chốt nếu thiếu trong dữ liệu gần nhất\n    required = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    present = {m.get('speaker') for m in msgs}\n    for name in required:\n        if name not in present:\n            msgs.append({\n                'speaker': name,\n                'time': datetime.now(timezone.utc).strftime('%H:%M UTC'),\n                'text': 'Em đang theo dõi hạng mục được giao và sẽ cập nhật tiến độ bằng tiếng Việt.',\n                'detail': '• Quyết định: Duy trì cập nhật minh bạch theo nhịp thời gian thực.\\n• Bước tiếp theo: Gửi báo cáo ngắn khi có thay đổi trạng thái.',\n                'rag': 'GREEN'\n            })\n    return msgs\n"}]},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"edits\":[{\"oldText\":\"def build_chat_messages(updates, limit=20):\\n    msgs = []\\n    for u in updates[-limit:]:\\n        raw = u.get('text', '')\\n        m = re.match(r'^(\\\\d{2}:\\\\d{2}(?:–\\\\d{2}:\\\\d{2})?\\\\sUTC)\\\\s*[:\\\\-]\\\\s*(.*)$', raw)\\n        if m:\\n            ts, body = m.group(1), m.group(2)\\n        else:\\n            ts, body = '', raw\\n        body_vi = to_vietnamese_text(body)\\n        detail = extract_technical_details_vi(body_vi)\\n\\n      