{"type":"message","id":"03f261bc","parentId":"3c052c34","timestamp":"2026-04-13T10:37:44.583Z","message":{"role":"toolResult","toolCallId":"call_lrbGRPRTGGNp3C9R1PXinkDX|","toolName":"read","content":[{"type":"text","text":"    const box=document.getElementById('voiceTranscript');\n    if(box) box.style.display='block';\n    const btn=document.getElementById('toggleHistoryBtn');\n    if(btn) btn.textContent='Ẩn lịch sử';\n  }catch(e){\n    appendVoiceLine('assistant','Dạ em chưa tải được lịch sử chat, anh bấm tải lại trang giúp em ạ.');\n  }\n}\n\nasync function createNewSession(){\n  try{\n    const name = prompt('Đặt tên phiên chat mới (có thể để trống):') || '';\n    const res = await fetch('/api/chat-sessions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});\n    const data = await res.json();\n    if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa tạo được phiên chat mới ạ.'); return; }\n    currentSessionId = data.session?.id || currentSessionId;\n    renderSessionOptions(data.sessions||[]);\n    renderVoiceHistory([]);\n  }catch(e){\n    appendVoiceLine('assistant','Dạ có lỗi khi tạo phiên chat mới, anh thử lại giúp em ạ.');\n  }\n}\n\nasync function askMinh(message){\n  try{\n    const selectedAgent = (document.getElementById('agentSelect')?.value || 'main').trim();\n    showPending(selectedAgent);\n    const sendBtn=document.getElementById('sendBtn');\n    if(sendBtn) sendBtn.disabled=true;\n    const payload = {message, attachments: chatAttachments, sessionId: currentSessionId, agentId: selectedAgent};\n    const res = await fetch('/api/minh-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n    const data = await res.json();\n    clearPending();\n    if(!data.ok){ appendVoiceLine('assistant','Dạ em xin lỗi anh, em chưa xử lý được yêu cầu này ạ.'); return; }\n    currentSessionId = data.sessionId || currentSessionId;\n    renderSessionOptions(data.sessions||[]);\n    renderVoiceHistory(data.history||[]);\n    speakText(data.reply);\n    chatAttachments=[];\n  }catch(e){\n    clearPending();\n    appendVoiceLine('assistant','Dạ đang lỗi kết nối chat. Anh bấm tải lại trang (Ctrl+F5) hoặc tạo phiên chat mới giúp em ạ.');\n  }finally{\n    const sendBtn=document.getElementById('sendBtn');\n    if(sendBtn) sendBtn.disabled=false;\n  }\n}\n\nasync function uploadBase64Image(imageData, source='upload'){\n  const res = await fetch('/api/upload-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({imageData, source})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa nhận được ảnh hợp lệ ạ.'); return; }\n  chatAttachments.push({type:'image', url:data.url});\n  appendVoiceLine('user',`[Đã đính kèm ảnh] ${data.url}`);\n}\n\nfunction pickImage(){ document.getElementById('imgPicker').click(); }\n\nfunction uploadPickedImage(ev){\n  const f = ev.target.files && ev.target.files[0];\n  if(!f) return;\n  const rd = new FileReader();\n  rd.onload = ()=> uploadBase64Image(rd.result, 'picker');\n  rd.readAsDataURL(f);\n  ev.target.value='';\n}\n\nasync function captureImage(){\n  const video=document.getElementById('camPreview');\n  const canvas=document.getElementById('camCanvas');\n\n  if(!camStream){\n    try{\n      camStream = await navigator.mediaDevices.getUserMedia({video:true});\n      video.srcObject = camStream;\n      video.style.display='block';\n      appendVoiceLine('assistant','Dạ em đã bật camera. Anh bấm lại nút Chụp ảnh để chụp ạ.');\n      return;\n    }catch(e){\n      appendVoiceLine('assistant','Dạ em không mở được camera, anh kiểm tra quyền truy cập giúp em ạ.');\n      return;\n    }\n  }\n\n  const w = video.videoWidth || 640;\n  const h = video.videoHeight || 480;\n  canvas.width=w; canvas.height=h;\n  const ctx=canvas.getContext('2d');\n  ctx.drawImage(video,0,0,w,h);\n  const dataUrl = canvas.toDataURL('image/png');\n  await uploadBase64Image(dataUrl, 'camera');\n}\n\nfunction speakText(text, retry=false){\n  if(!text) return;\n  if(!window.speechSynthesis){\n    appendVoiceLine('assistant','Dạ trình duyệt không hỗ trợ phát giọng nói ạ.');\n    return;\n  }\n  speechSynthesis.cancel();\n  speechSynthesis.resume();\n  speaking=true;\n  if(recog && listening){\n    try{recog.stop();}catch(e){}\n  }\n  const chunks = splitSpeechChunks(text);\n  if(!chunks.length) return;\n\n  let idx = 0;\n  const v = pickVietnameseVoice();\n  let started=false;\n  const startGuard = setTimeout(()=>{\n    if(started) return;\n    speaking=false;\n    if(!retry){\n      // Thu gọn nội dung để thử lại nhanh khi engine TTS bị kẹt.\n      speakText(text.slice(0, 220), true);\n      return;\n    }\n    if(voiceEnabled){\n      document.getElementById('voiceState').textContent='Trạng thái: không phát được âm thanh, anh bấm lại Bật hội thoại rảnh tay giúp em.';\n      startContinuousListening();\n    }\n  }, 1700);\n\n  const speakNext = ()=>{\n    const chunk = chunks[idx++];\n    if(!chunk){\n      clearTimeout(startGuard);\n      speaking=false;\n      if(voiceEnabled){\n        startContinuousListening();\n      }else{\n        document.getElementById('voiceState').textContent='Trạng thái: tắt';\n      }\n      return;\n    }\n\n    const u = new SpeechSynthesisUtterance(chunk);\n    u.lang='vi-VN';\n\n[241 more lines in file. Use offset=470 to continue.]"}],"isError":false,"timestamp":1776076664577}}
