{"type":"message","id":"3f65c1b3","parentId":"8e8bbba0","timestamp":"2026-04-13T14:57:13.194Z","message":{"role":"toolResult","toolCallId":"call_ZIjJ7kLFvOUxGUsjT6SwCV7L|","toolName":"read","content":[{"type":"text","text":"                    continue\n                ts = obj.get('timestamp', '')\n                if not ts.startswith(today):\n                    continue\n                msg = obj.get('message', {})\n                usage = msg.get('usage', {})\n                i = usage.get('input', 0) or 0\n                o = usage.get('output', 0) or 0\n                if i or o:\n                    token_in += int(i)\n                    token_out += int(o)\n                    count += 1\n    except Exception:\n        pass\n    return {'in': token_in, 'out': token_out, 'total': token_in + token_out, 'messages': count}\n\n\ndef parse_team_updates(limit=25):\n    files = sorted(TEAM_LOGS.glob('*.md'))\n    if not files:\n        return []\n    latest = files[-1]\n    lines = read_text(latest).splitlines()\n    updates = []\n    for ln in lines:\n        if ln.startswith('- '):\n            text = ln[2:].strip()\n            rag = 'GREEN'\n            up = text.upper()\n            if 'RAG: RED' in up or ' RED ' in up:\n                rag = 'RED'\n            elif 'RAG: AMBER' in up or ' AMBER' in up:\n                rag = 'AMBER'\n            updates.append({'text': text, 'rag': rag})\n    return updates[-limit:]\n\n\ndef owner_activity(updates):\n    owners = {'Mạnh AI': 0, 'Huy AI': 0, 'Hà AI': 0, 'Huyền AI': 0, 'MINH AI': 0}\n    for u in updates:\n        t = u['text']\n        for name in list(owners.keys()):\n            if name in t:\n                owners[name] += 1\n    return owners\n\n\ndef to_vietnamese_text(text: str) -> str:\n    repl = {\n        'Decision:': 'Quyết định:',\n        'Owners:': 'Phụ trách:',\n        'Owner:': 'Phụ trách:',\n        'Blockers:': 'Vướng mắc:',\n        'Next:': 'Bước tiếp theo:',\n        'ETA:': 'Hạn dự kiến:',\n        'Evidence:': 'Bằng chứng:',\n        'Execution completed successfully': 'Thực thi hoàn tất thành công',\n        'requested': 'yêu cầu',\n        'approved': 'đã phê duyệt',\n        'service running': 'dịch vụ đang chạy',\n        'pending': 'đang chờ',\n        'User asked': 'Anh Minh hỏi',\n        'User requested': 'Anh Minh yêu cầu',\n        'User approved': 'Anh Minh đã phê duyệt',\n        'User confirmed': 'Anh Minh xác nhận',\n        'keep overall delivery': 'giữ trạng thái triển khai tổng thể',\n        'completed hardening package': 'đã hoàn tất gói hardening',\n        'feature delivered': 'đã bàn giao tính năng',\n        'manh/huy/ha/huyen': 'Mạnh AI/Huy AI/Hà AI/Huyền AI',\n        'manh': 'Mạnh',\n        'huyen': 'Huyền',\n        'ha': 'Hà',\n        'huy': 'Huy',\n        'done now': 'hoàn tất ngay',\n        'frontend': 'giao diện',\n        'backend': 'phía máy chủ',\n        'payload': 'gói dữ liệu',\n        'deployment': 'triển khai',\n        'acceptance': 'nghiệm thu',\n    }\n    out = text\n    for k, v in repl.items():\n        out = out.replace(k, v)\n    return out\n\n\ndef summarize_non_technical_vi(text: str) -> str:\n    cleaned = text\n    for mk in [' Bằng chứng:', ' Vướng mắc:', ' Hạn dự kiến:', ' Bước tiếp theo:', ' RAG:', ' Quyết định:', ' Phụ trách:']:\n        idx = cleaned.find(mk)\n        if idx != -1:\n            cleaned = cleaned[:idx]\n    cleaned = cleaned.strip(' .;')\n\n    low = cleaned.lower()\n\n    # Mẫu tóm tắt ưu tiên tiếng Việt, dễ đọc trên mobile\n    if 'hiding technical content' in low or 'ẩn nội dung kỹ thuật' in low:\n        return 'Anh Minh yêu cầu ẩn nội dung kỹ thuật mặc định và cho phép bấm xem thêm theo từng tin nhắn.'\n    if 'chat conversation in vietnamese' in low or 'hội thoại' in low:\n        return 'Đội bot cập nhật: phần trao đổi nội bộ đã chuyển sang dạng hội thoại tiếng Việt.'\n    if 'production hardening' in low or 'hardening' in low:\n        return 'Đội bot báo đã hoàn tất hardening bản dashboard và xác thực truy cập.'\n    if 'visual monitoring ui' in low or 'monitoring' in low:\n        return 'Anh Minh yêu cầu dashboard trực quan realtime để theo dõi tiến độ, lỗi và hiệu suất VPS.'\n    if 'hourly pm report' in low or 'báo cáo giờ' in low:\n        return 'MINH AI đã phát hành báo cáo giờ với trạng thái RAG và các rủi ro cần xử lý.'\n    if 'reports to be 100% vietnamese' in low or '100% vietnamese' in low:\n        return 'Anh Minh yêu cầu toàn bộ báo cáo hiển thị bằng tiếng Việt để dễ theo dõi.'\n    if 'internal scrum sync' in low or 'scrum sync' in low:\n        return 'Các bot đã đồng bộ nhanh, chốt đầu việc và mốc giờ thực thi trong phiên hiện tại.'\n\n    # Chuẩn hoá một số câu hội thoại tự nhiên\n    cleaned = cleaned.replace('Anh Minh hỏi', 'Anh Minh hỏi:')\n    cleaned = cleaned.replace('Anh Minh yêu cầu', 'Anh Minh yêu cầu:')\n    cleaned = cleaned.replace('Anh Minh đã phê duyệt', 'Anh Minh đã phê duyệt:')\n\n    # Nếu còn nhiều tiếng Anh thì thay bằng bản tóm tắt trung tính tiếng Việt\n    ascii_words = re.findall(r'[A-Za-z]{3,}', cleaned)\n    if len(ascii_words) >= 8:\n        return 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.'\n\n    if len(cleaned) < 12:\n        cleaned = 'Cập nhật công việc mới từ bot.'\n    return cleaned\n\n\ndef _extract_field(text: str, labels: list[str]) -> str:\n    points = []\n    all_labels = [\n        'Quyết định:', 'Phụ trách:', 'Vướng mắc:', 'Hạn dự kiến:', 'Bước tiếp theo:', 'Bằng chứng:',\n        'Decision:', 'Owners:', 'Owner:', 'Blockers:', 'ETA:', 'Next:', 'Evidence:'\n    ]\n    for lb in labels:\n        idx = text.find(lb)\n        if idx != -1:\n            start = idx + len(lb)\n            end = len(text)\n            for x in all_labels:\n                j = text.find(x, start)\n                if j != -1:\n                    end = min(end, j)\n            points.append(text[start:end].strip(' .;'))\n    return points[0] if points else ''\n\n\ndef _normalize_vi_phrase(text: str) -> str:\n    repl = {\n        'pending': 'đang chờ',\n        'none': 'không có',\n        'service': 'dịch vụ',\n        'running': 'đang chạy',\n        'feature': 'tính năng',\n        'dashboard': 'bảng điều hành',\n        'hardening': 'gia cố bảo mật',\n        'restart': 'khởi động lại',\n        'scope': 'phạm vi',\n        'requirement': 'yêu cầu',\n        'contract': 'hợp đồng giao tiếp',\n        'evidence': 'bằng chứng',\n        'blocker': 'điểm nghẽn',\n        'sync': 'đồng bộ',\n    }\n    out = text\n    for k, v in repl.items():\n        out = re.sub(rf'\\b{k}\\b', v, out, flags=re.IGNORECASE)\n    return out\n\n\ndef _simplify_tech_phrase_vi(text: str) -> str:\n    t = _normalize_vi_phrase(text)\n    low = t.lower()\n\n    if 'toggle' in low or 'nút' in low or 'ẩn' in low or 'hiện' in low:\n        return 'Đã bổ sung cơ chế ẩn/hiện nội dung kỹ thuật theo từng mục và theo từng tin nhắn.'\n    if 'api/metrics' in low or ('api' in low and 'metrics' in low):\n        return 'API số liệu hoạt động ổn định và trả dữ liệu đầy đủ cho giao diện.'\n    if 'systemctl' in low or 'khởi động lại' in low or 'dịch vụ' in low:\n        return 'Dịch vụ đã được khởi động lại và đang vận hành ổn định.'\n    if 'swap' in low:\n        return 'Đã cấu hình bộ nhớ hoán đổi (swap) và tối ưu tham số vận hành.'\n    if 'https' in low or 'tls' in low:\n        return 'Hạng mục bảo mật đường truyền (HTTPS/TLS) đang được theo dõi theo kế hoạch.'\n\n    ascii_words = re.findall(r'[A-Za-z]{3,}', t)\n    if len(ascii_words) >= 6:\n        return 'Nội dung kỹ thuật đã được chuẩn hóa và ghi nhận trong hệ thống theo dõi.'\n\n    return t\n\n\ndef extract_technical_details_vi(text: str) -> str:\n    t = to_vietnamese_text(text)\n\n    decision = _extract_field(t, ['Quyết định:', 'Decision:'])\n    owners = _extract_field(t, ['Phụ trách:', 'Owners:', 'Owner:'])\n    blockers = _extract_field(t, ['Vướng mắc:', 'Blockers:'])\n    eta = _extract_field(t, ['Hạn dự kiến:', 'ETA:'])\n    next_step = _extract_field(t, ['Bước tiếp theo:', 'Next:'])\n    evidence = _extract_field(t, ['Bằng chứng:', 'Evidence:'])\n\n    lines = []\n    if decision:\n        lines.append('• Quyết định: ' + _simplify_tech_phrase_vi(decision))\n    if owners:\n        lines.append('• Phụ trách: ' + _normalize_vi_phrase(owners))\n    if eta:\n        lines.append('• Hạn dự kiến: ' + _simplify_tech_phrase_vi(eta))\n    if blockers:\n        lines.append('• Vướng mắc: ' + _simplify_tech_phrase_vi(blockers))\n    if next_step:\n        lines.append('• Bước tiếp theo: ' + _simplify_tech_phrase_vi(next_step))\n    if evidence:\n        lines.append('• Bằng chứng: ' + _simplify_tech_phrase_vi(evidence))\n\n    if not lines:\n        fallback = summarize_non_technical_vi(t)\n        lines.append('• Tóm tắt kỹ thuật: ' + fallback)\n\n    detail = '\\n'.join(lines).strip()\n    return detail if detail else 'Không có chi tiết kỹ thuật bổ sung.'\n\n\ndef detect_speaker(text: str) -> str:\n    names = ['MINH AI', 'Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    pos = []\n    for n in names:\n        i = text.find(n)\n        if i != -1:\n            pos.append((i, n))\n    if pos:\n        pos.sort(key=lambda x: x[0])\n        return pos[0][1]\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef extract_owner_messages(text: str):\n    out = []\n    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': content})\n    return out\n\n\ndef humanize_owner_update(speaker: str, content: str) -> str:\n    c = _normalize_vi_phrase(content)\n    c = c.replace('OpenAPI', 'đặc tả API').replace('SLO', 'mục tiêu mức dịch vụ').replace('UAT', 'kiểm thử nghiệm thu')\n    c = c.replace('SIT', 'kiểm thử tích hợp hệ thống').replace('contract-test', 'kiểm thử hợp đồng giao tiếp')\n    if speaker == 'Mạnh AI':\n        return f'Em cập nhật nhanh: {c}.'\n    if speaker == 'Huy AI':\n        return f'Phần giao diện em đang xử lý: {c}.'\n    if speaker == 'Hà AI':\n        return f'Phần máy chủ em đang triển khai: {c}.'\n    if speaker == 'Huyền AI':\n        return f'Phần phân tích nghiệp vụ em đang theo dõi: {c}.'\n    return f'Em cập nhật: {c}.'\n\n\ndef humanize_preview(speaker: str, preview: str) -> str:\n    if 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.' in preview:\n        mapping = {\n            'Mạnh AI': 'Em đang bám sát tiến độ kỹ thuật tổng thể, có thay đổi em báo anh ngay.',\n            'Huy AI': 'Em đang rà soát giao diện và trải nghiệm người dùng, có bản mới em cập nhật liền.',\n            'Hà AI': 'Em đang theo dõi phần máy chủ và dữ liệu, có rủi ro em cảnh báo sớm cho anh.',\n            'Huyền AI': 'Em đang tổng hợp yêu cầu và tiêu chí nghiệm thu, để anh theo dõi dễ hơn.',\n            'MINH AI': 'Em đang điều phối tiến độ chung và theo dõi các điểm nghẽn theo thời gian thực.'\n        }\n        return mapping.get(speaker, preview)\n    return preview\n\n\ndef recent_internal_agent_messages(limit=10):\n    _ensure_sessions_loaded()\n    id_to_name = {\n        'main': 'MINH AI',\n        'manh': 'Mạnh AI',\n        'huy': 'Huy AI',\n        'ha': 'Hà AI',\n        'huyen': 'Huyền AI',\n    }\n    rows = []\n    try:\n        sessions = sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)\n        for s in sessions:\n            for m in (s.get('messages') or []):\n                if m.get('role') != 'assistant':\n                    continue\n                aid = (m.get('agentId') or 'main').strip().lower()\n                if aid not in id_to_name:\n                    continue\n                txt = (m.get('text') or '').strip()\n                if not txt:\n                    continue\n                ts = (m.get('ts') or '')\n                hhmm = ''\n                try:\n                    hhmm = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(timezone.utc).strftime('%H:%M UTC')\n                except Exception:\n                    hhmm = datetime.now(timezone.utc).strftime('%H:%M UTC')\n                rows.append({\n                    'speaker': id_to_name[aid],\n                    'time': hhmm,\n                    'text': txt,\n                    'detail': 'Nguồn: hội thoại trực tiếp tại khu chat với MINH AI.',\n                    'rag': 'GREEN'\n                })\n    except Exception:\n        return []\n\n    rows = sorted(rows, key=lambda x: x.get('time', ''), reverse=True)\n    return rows[:limit]\n\n\ndef build_chat_messages(updates, limit=20):\n    msgs = []\n    for u in updates[-limit:]:\n        raw = u.get('text', '')\n        m = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', raw)\n        if m:\n            ts, body = m.group(1), m.group(2)\n        else:\n            ts, body = '', raw\n        body_vi = to_vietnamese_text(body)\n        detail = extract_technical_details_vi(body_vi)\n\n        owner_msgs = extract_owner_messages(body_vi)\n        if owner_msgs:\n            for om in owner_msgs:\n                msgs.append({\n                    'speaker': om['speaker'],\n                    'time': ts,\n                    'text': humanize_owner_update(om['speaker'], om['text']),\n                    'detail': detail,\n                    'rag': u.get('rag', 'GREEN')\n                })\n            continue\n\n        speaker = detect_speaker(body_vi)\n        preview = summarize_non_technical_vi(body_vi)\n        preview = humanize_preview(speaker, preview)\n        msgs.append({\n            'speaker': speaker,\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n\n    # Ưu tiên bổ sung hội thoại thực tế từ phiên chat nội bộ nếu có\n    internal_msgs = recent_internal_agent_messages(limit=12)\n    if internal_msgs:\n        msgs.extend(internal_msgs)\n\n    # Bổ sung hiện diện hội thoại cho đủ các bot chủ chốt nếu thiếu trong dữ liệu gần nhất\n    required = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    present = {m.get('speaker') for m in msgs}\n    for name in required:\n        if name not in present:\n            msgs.append({\n                'speaker': name,\n                'time': datetime.now(timezone.utc).strftime('%H:%M UTC'),\n                'text': 'Em đang theo dõi hạng mục được giao và sẽ cập nhật tiến độ bằng tiếng Việt.',\n                'detail': '• Quyết định: Duy trì cập nhật minh bạch theo nhịp thời gian thực.\\n• Bước tiếp theo: Gửi báo cáo ngắn khi có thay đổi trạng thái.',\n                'rag': 'GREEN'\n            })\n    return msgs[-max(limit,24):]\n\n\ndef parse_priority_blockers(updates, limit=8):\n    items = []\n    for u in updates:\n        txt = u.get('text', '')\n        ts = ''\n        m_time = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', txt)\n        body = txt\n        if m_time:\n            ts, body = m_time.group(1), m_time.group(2)\n\n        speaker = detect_speaker(to_vietnamese_text(body))\n\n        m = re.search(r'(Blockers:|Vướng mắc:)(.*?)(Next:|Bước tiếp theo:|$)', body, re.IGNORECASE)\n        if not m:\n            continue\n        raw = m.group(2).strip(' .;')\n        raw_vi = _normalize_vi_phrase(to_vietnamese_text(raw))\n        low = raw_vi.lower()\n\n        if not raw_vi or low in {'none', 'không có'} or low.startswith('không có'):\n            continue\n\n        severity = 'AMBER'\n        if any(k in low for k in ['blocked', 'đang chờ', 'không xác nhận', 'chưa xác nhận', 'missing', 'thiếu', 'password', 'không có quyền']):\n            severity = 'RED'\n\n        text_view = _simplify_tech_phrase_vi(raw_vi)\n        if text_view == 'Nội dung kỹ thuật đã được chuẩn hóa và ghi nhận trong hệ thống theo dõi.':\n            text_view = 'Có vướng mắc cần ưu tiên xử lý, vui lòng mở bối cảnh để xem chi tiết quyết định.'\n\n        items.append({\n            'time': ts,\n            'speaker': speaker,\n            'text': text_view,\n            'severity': severity,\n            'source': summarize_non_technical_vi(to_vietnamese_text(body)),\n            'raw': raw_vi,\n        })\n\n    def rank(x):\n        sev = 2 if x['severity'] == 'RED' else 1\n        return (sev, x.get('time', ''))\n\n    items.sort(key=rank, reverse=True)\n    return items[:limit]\n\n\ndef top_processes():\n    try:\n        out = subprocess.check_output(\n            \"ps -eo comm,%cpu,%mem --sort=-%cpu | head -n 8\",\n            shell=True,\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n        rows = []\n        for ln in out.splitlines()[1:]:\n            parts = ln.split()\n            if len(parts) >= 3:\n                rows.append({'name': parts[0], 'cpu': float(parts[1]), 'mem': float(parts[2])})\n        return rows\n    except Exception:\n        return []\n\n\ndef build_payload():\n    now = datetime.now(timezone.utc).isoformat()\n    cpu = cpu_usage_percent()\n    load1, load5, load15 = os.getloadavg()\n\n[409 more lines in file. Use offset=750 to continue.]"}],"isError":false,"timestamp":1776092233182}}
