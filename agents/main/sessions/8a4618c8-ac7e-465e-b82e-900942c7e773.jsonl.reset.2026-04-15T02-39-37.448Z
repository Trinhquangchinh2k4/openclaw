{"type":"message","id":"9a3518b5","parentId":"2770b37f","timestamp":"2026-04-13T14:58:18.983Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_Cxe296aDfuFuOj0WX0rfwvv8|","name":"edit","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","edits":[{"oldText":"def recent_internal_agent_messages(limit=10):\n    _ensure_sessions_loaded()\n    id_to_name = {\n        'main': 'MINH AI',\n        'manh': 'Mạnh AI',\n        'huy': 'Huy AI',\n        'ha': 'Hà AI',\n        'huyen': 'Huyền AI',\n    }\n    rows = []\n    try:\n        sessions = sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)\n        for s in sessions:\n            for m in (s.get('messages') or []):\n                if m.get('role') != 'assistant':\n                    continue\n                aid = (m.get('agentId') or 'main').strip().lower()\n                if aid not in id_to_name:\n                    continue\n                txt = (m.get('text') or '').strip()\n                if not txt:\n                    continue\n                ts = (m.get('ts') or '')\n                hhmm = ''\n                try:\n                    hhmm = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(timezone.utc).strftime('%H:%M UTC')\n                except Exception:\n                    hhmm = datetime.now(timezone.utc).strftime('%H:%M UTC')\n                rows.append({\n                    'speaker': id_to_name[aid],\n                    'time': hhmm,\n                    'text': txt,\n                    'detail': 'Nguồn: hội thoại trực tiếp tại khu chat với MINH AI.',\n                    'rag': 'GREEN'\n                })\n    except Exception:\n        return []\n\n    rows = sorted(rows, key=lambda x: x.get('time', ''), reverse=True)\n    return rows[:limit]\n","newText":"def recent_internal_agent_messages(limit=10):\n    _ensure_sessions_loaded()\n    id_to_name = {\n        'main': 'MINH AI',\n        'manh': 'Mạnh AI',\n        'huy': 'Huy AI',\n        'ha': 'Hà AI',\n        'huyen': 'Huyền AI',\n    }\n    rows = []\n    try:\n        sessions = sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)\n        now_utc = datetime.now(timezone.utc)\n        cutoff = now_utc - timedelta(minutes=60)\n        for s in sessions:\n            for m in (s.get('messages') or []):\n                if m.get('role') != 'assistant':\n                    continue\n                aid = (m.get('agentId') or 'main').strip().lower()\n                if aid not in id_to_name:\n                    continue\n                txt = (m.get('text') or '').strip()\n                if not txt:\n                    continue\n                ts = (m.get('ts') or '')\n                try:\n                    dt = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(timezone.utc)\n                except Exception:\n                    dt = now_utc\n                if dt < cutoff:\n                    continue\n                rows.append({\n                    'speaker': id_to_name[aid],\n                    'time': dt.strftime('%H:%M UTC'),\n                    '_ts': dt.timestamp(),\n                    'text': txt,\n                    'detail': 'Nguồn: hội thoại trực tiếp tại khu chat với MINH AI.',\n                    'rag': 'GREEN'\n                })\n    except Exception:\n        return []\n\n    # loại trùng nhẹ theo (speaker,text,time)\n    dedup = {}\n    for r in rows:\n        k = (r.get('speaker'), r.get('text'), r.get('time'))\n        dedup[k] = r\n    rows = sorted(dedup.values(), key=lambda x: x.get('_ts', 0), reverse=True)\n    for r in rows:\n        r.pop('_ts', None)\n    return rows[:limit]\n"}]},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"edits\":[{\"oldText\":\"def recent_internal_agent_messages(limit=10):\\n    _ensure_sessions_loaded()\\n    id_to_name = {\\n        'main': 'MINH AI',\\n        '