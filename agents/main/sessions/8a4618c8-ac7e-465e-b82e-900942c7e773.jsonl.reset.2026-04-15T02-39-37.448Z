{"type":"message","id":"42f3e918","parentId":"963706e0","timestamp":"2026-04-13T07:28:30.457Z","message":{"role":"toolResult","toolCallId":"call_pdzjJBok9RIYsucc4bE1hucr|","toolName":"read","content":[{"type":"text","text":"    owners = {'Mạnh AI': 0, 'Huy AI': 0, 'Hà AI': 0, 'Huyền AI': 0, 'MINH AI': 0}\n    for u in updates:\n        t = u['text']\n        for name in list(owners.keys()):\n            if name in t:\n                owners[name] += 1\n    return owners\n\n\ndef to_vietnamese_text(text: str) -> str:\n    repl = {\n        'Decision:': 'Quyết định:',\n        'Owners:': 'Phụ trách:',\n        'Owner:': 'Phụ trách:',\n        'Blockers:': 'Vướng mắc:',\n        'Next:': 'Bước tiếp theo:',\n        'ETA:': 'Hạn dự kiến:',\n        'Evidence:': 'Bằng chứng:',\n        'Execution completed successfully': 'Thực thi hoàn tất thành công',\n        'requested': 'yêu cầu',\n        'approved': 'đã phê duyệt',\n        'service running': 'dịch vụ đang chạy',\n        'pending': 'đang chờ',\n        'User asked': 'Anh Minh hỏi',\n        'User requested': 'Anh Minh yêu cầu',\n        'User approved': 'Anh Minh đã phê duyệt',\n        'User confirmed': 'Anh Minh xác nhận',\n        'keep overall delivery': 'giữ trạng thái triển khai tổng thể',\n        'completed hardening package': 'đã hoàn tất gói hardening',\n        'feature delivered': 'đã bàn giao tính năng',\n        'manh/huy/ha/huyen': 'Mạnh AI/Huy AI/Hà AI/Huyền AI',\n        'manh': 'Mạnh',\n        'huyen': 'Huyền',\n        'ha': 'Hà',\n        'huy': 'Huy',\n        'done now': 'hoàn tất ngay',\n        'frontend': 'giao diện',\n        'backend': 'phía máy chủ',\n        'payload': 'gói dữ liệu',\n        'deployment': 'triển khai',\n        'acceptance': 'nghiệm thu',\n    }\n    out = text\n    for k, v in repl.items():\n        out = out.replace(k, v)\n    return out\n\n\ndef summarize_non_technical_vi(text: str) -> str:\n    cleaned = text\n    for mk in [' Bằng chứng:', ' Vướng mắc:', ' Hạn dự kiến:', ' Bước tiếp theo:', ' RAG:', ' Quyết định:', ' Phụ trách:']:\n        idx = cleaned.find(mk)\n        if idx != -1:\n            cleaned = cleaned[:idx]\n    cleaned = cleaned.strip(' .;')\n\n    low = cleaned.lower()\n\n    # Mẫu tóm tắt ưu tiên tiếng Việt, dễ đọc trên mobile\n    if 'hiding technical content' in low or 'ẩn nội dung kỹ thuật' in low:\n        return 'Anh Minh yêu cầu ẩn nội dung kỹ thuật mặc định và cho phép bấm xem thêm theo từng tin nhắn.'\n    if 'chat conversation in vietnamese' in low or 'hội thoại' in low:\n        return 'Đội bot cập nhật: phần trao đổi nội bộ đã chuyển sang dạng hội thoại tiếng Việt.'\n    if 'production hardening' in low or 'hardening' in low:\n        return 'Đội bot báo đã hoàn tất hardening bản dashboard và xác thực truy cập.'\n    if 'visual monitoring ui' in low or 'monitoring' in low:\n        return 'Anh Minh yêu cầu dashboard trực quan realtime để theo dõi tiến độ, lỗi và hiệu suất VPS.'\n    if 'hourly pm report' in low or 'báo cáo giờ' in low:\n        return 'MINH AI đã phát hành báo cáo giờ với trạng thái RAG và các rủi ro cần xử lý.'\n    if 'internal scrum sync' in low or 'scrum sync' in low:\n        return 'Các bot đã đồng bộ nhanh, chốt đầu việc và mốc giờ thực thi trong phiên hiện tại.'\n\n    # Chuẩn hoá một số câu hội thoại tự nhiên\n    cleaned = cleaned.replace('Anh Minh hỏi', 'Anh Minh hỏi:')\n    cleaned = cleaned.replace('Anh Minh yêu cầu', 'Anh Minh yêu cầu:')\n    cleaned = cleaned.replace('Anh Minh đã phê duyệt', 'Anh Minh đã phê duyệt:')\n\n    # Nếu còn nhiều tiếng Anh thì thay bằng bản tóm tắt trung tính tiếng Việt\n    ascii_words = re.findall(r'[A-Za-z]{3,}', cleaned)\n    if len(ascii_words) >= 8:\n        return 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.'\n\n    if len(cleaned) < 12:\n        cleaned = 'Cập nhật công việc mới từ bot.'\n    return cleaned\n\n\ndef _extract_field(text: str, labels: list[str]) -> str:\n    points = []\n    all_labels = [\n        'Quyết định:', 'Phụ trách:', 'Vướng mắc:', 'Hạn dự kiến:', 'Bước tiếp theo:', 'Bằng chứng:',\n        'Decision:', 'Owners:', 'Owner:', 'Blockers:', 'ETA:', 'Next:', 'Evidence:'\n    ]\n    for lb in labels:\n        idx = text.find(lb)\n        if idx != -1:\n            start = idx + len(lb)\n            end = len(text)\n            for x in all_labels:\n                j = text.find(x, start)\n                if j != -1:\n                    end = min(end, j)\n            points.append(text[start:end].strip(' .;'))\n    return points[0] if points else ''\n\n\ndef _normalize_vi_phrase(text: str) -> str:\n    repl = {\n        'pending': 'đang chờ',\n        'none': 'không có',\n        'service': 'dịch vụ',\n        'running': 'đang chạy',\n        'feature': 'tính năng',\n        'dashboard': 'bảng điều hành',\n        'hardening': 'gia cố bảo mật',\n        'restart': 'khởi động lại',\n        'scope': 'phạm vi',\n        'requirement': 'yêu cầu',\n        'contract': 'hợp đồng giao tiếp',\n        'evidence': 'bằng chứng',\n        'blocker': 'điểm nghẽn',\n        'sync': 'đồng bộ',\n    }\n    out = text\n    for k, v in repl.items():\n        out = re.sub(rf'\\b{k}\\b', v, out, flags=re.IGNORECASE)\n    return out\n\n\ndef _simplify_tech_phrase_vi(text: str) -> str:\n    t = _normalize_vi_phrase(text)\n    low = t.lower()\n\n    if 'toggle' in low or 'nút' in low or 'ẩn' in low or 'hiện' in low:\n        return 'Đã bổ sung cơ chế ẩn/hiện nội dung kỹ thuật theo từng mục và theo từng tin nhắn.'\n    if 'api/metrics' in low or ('api' in low and 'metrics' in low):\n        return 'API số liệu hoạt động ổn định và trả dữ liệu đầy đủ cho giao diện.'\n    if 'systemctl' in low or 'khởi động lại' in low or 'dịch vụ' in low:\n        return 'Dịch vụ đã được khởi động lại và đang vận hành ổn định.'\n    if 'swap' in low:\n        return 'Đã cấu hình bộ nhớ hoán đổi (swap) và tối ưu tham số vận hành.'\n    if 'https' in low or 'tls' in low:\n        return 'Hạng mục bảo mật đường truyền (HTTPS/TLS) đang được theo dõi theo kế hoạch.'\n\n    ascii_words = re.findall(r'[A-Za-z]{3,}', t)\n    if len(ascii_words) >= 6:\n        return 'Nội dung kỹ thuật đã được chuẩn hóa và ghi nhận trong hệ thống theo dõi.'\n\n    return t\n\n\ndef extract_technical_details_vi(text: str) -> str:\n    t = to_vietnamese_text(text)\n\n    decision = _extract_field(t, ['Quyết định:', 'Decision:'])\n    owners = _extract_field(t, ['Phụ trách:', 'Owners:', 'Owner:'])\n    blockers = _extract_field(t, ['Vướng mắc:', 'Blockers:'])\n    eta = _extract_field(t, ['Hạn dự kiến:', 'ETA:'])\n    next_step = _extract_field(t, ['Bước tiếp theo:', 'Next:'])\n    evidence = _extract_field(t, ['Bằng chứng:', 'Evidence:'])\n\n    lines = []\n    if decision:\n        lines.append('• Quyết định: ' + _simplify_tech_phrase_vi(decision))\n    if owners:\n        lines.append('• Phụ trách: ' + _normalize_vi_phrase(owners))\n    if eta:\n        lines.append('• Hạn dự kiến: ' + _simplify_tech_phrase_vi(eta))\n    if blockers:\n        lines.append('• Vướng mắc: ' + _simplify_tech_phrase_vi(blockers))\n    if next_step:\n        lines.append('• Bước tiếp theo: ' + _simplify_tech_phrase_vi(next_step))\n    if evidence:\n        lines.append('• Bằng chứng: ' + _simplify_tech_phrase_vi(evidence))\n\n    if not lines:\n        fallback = summarize_non_technical_vi(t)\n        lines.append('• Tóm tắt kỹ thuật: ' + fallback)\n\n    detail = '\\n'.join(lines).strip()\n    return detail if detail else 'Không có chi tiết kỹ thuật bổ sung.'\n\n\ndef detect_speaker(text: str) -> str:\n    names = ['MINH AI', 'Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    pos = []\n    for n in names:\n        i = text.find(n)\n        if i != -1:\n            pos.append((i, n))\n    if pos:\n        pos.sort(key=lambda x: x[0])\n        return pos[0][1]\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef extract_owner_messages(text: str):\n    out = []\n    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': f'Em cập nhật: {content}.'})\n    return out\n\n\ndef build_chat_messages(updates, limit=20):\n    msgs = []\n    for u in updates[-limit:]:\n        raw = u.get('text', '')\n        m = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', raw)\n        if m:\n            ts, body = m.group(1), m.group(2)\n        else:\n            ts, body = '', raw\n        body_vi = to_vietnamese_text(body)\n        detail = extract_technical_details_vi(body_vi)\n\n        owner_msgs = extract_owner_messages(body_vi)\n        if owner_msgs:\n            for om in owner_msgs:\n                msgs.append({\n                    'speaker': om['speaker'],\n                    'time': ts,\n                    'text': _simplify_tech_phrase_vi(om['text']),\n                    'detail': detail,\n                    'rag': u.get('rag', 'GREEN')\n                })\n            continue\n\n\n[199 more lines in file. Use offset=390 to continue.]"}],"isError":false,"timestamp":1776065310454}}
{"type":"message","id":"c95ff72d","parentId":"42f3e918","timestamp":"2026-04-13T07:28:34.250Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_gwll3wxwiPfNWC4wmzEktBE8|","name":"read","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","offset":390,"limit":220},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"offset\":390,\"limit\":220}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":2770,"output":43,"cacheRead":118016,"cacheWrite":0,"totalTokens":120829,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776065310470,"responseId":""}}
{"type":"message","id":"dface0f0","parentId":"c95ff72d","timestamp":"2026-04-13T07:28:34.263Z","message":{"role":"toolResult","toolCallId":"call_gwll3wxwiPfNWC4wmzEktBE8|","toolName":"read","content":[{"type":"text","text":"        preview = summarize_non_technical_vi(body_vi)\n        msgs.append({\n            'speaker': detect_speaker(body_vi),\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n\n    # Bổ sung hiện diện hội thoại cho đủ các bot chủ chốt nếu thiếu trong dữ liệu gần nhất\n    required = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    present = {m.get('speaker') for m in msgs}\n    for name in required:\n        if name not in present:\n            msgs.append({\n                'speaker': name,\n                'time': datetime.now(timezone.utc).strftime('%H:%M UTC'),\n                'text': 'Em đang theo dõi hạng mục được giao và sẽ cập nhật tiến độ bằng tiếng Việt.',\n                'detail': '• Quyết định: Duy trì cập nhật minh bạch theo nhịp thời gian thực.\\n• Bước tiếp theo: Gửi báo cáo ngắn khi có thay đổi trạng thái.',\n                'rag': 'GREEN'\n            })\n    return msgs\n\n\ndef top_processes():\n    try:\n        out = subprocess.check_output(\n            \"ps -eo comm,%cpu,%mem --sort=-%cpu | head -n 8\",\n            shell=True,\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n        rows = []\n        for ln in out.splitlines()[1:]:\n            parts = ln.split()\n            if len(parts) >= 3:\n                rows.append({'name': parts[0], 'cpu': float(parts[1]), 'mem': float(parts[2])})\n        return rows\n    except Exception:\n        return []\n\n\ndef build_payload():\n    now = datetime.now(timezone.utc).isoformat()\n    cpu = cpu_usage_percent()\n    load1, load5, load15 = os.getloadavg()\n    mem = mem_info()\n\n    mem_total = mem.get('MemTotal', 0)\n    mem_avail = mem.get('MemAvailable', 0)\n    mem_used = max(mem_total - mem_avail, 0)\n    mem_pct = round((mem_used / mem_total * 100), 1) if mem_total else 0\n\n    swap_total = mem.get('SwapTotal', 0)\n    swap_free = mem.get('SwapFree', 0)\n    swap_used = max(swap_total - swap_free, 0)\n    swap_pct = round((swap_used / swap_total * 100), 1) if swap_total else 0\n\n    disk = shutil.disk_usage('/')\n    disk_pct = round((disk.used / disk.total * 100), 1)\n\n    tokens = token_stats_today()\n    updates = parse_team_updates()\n    owners = owner_activity(updates)\n\n    rag_counts = {'GREEN': 0, 'AMBER': 0, 'RED': 0}\n    blocker_count = 0\n    for u in updates:\n        rag_counts[u['rag']] = rag_counts.get(u['rag'], 0) + 1\n        if 'blocker' in u['text'].lower() or 'blocked' in u['text'].lower():\n            blocker_count += 1\n\n    est_usd = (tokens['in'] / 1_000_000.0) * IN_USD_PER_1M + (tokens['out'] / 1_000_000.0) * OUT_USD_PER_1M\n    est_vnd = int(round(est_usd * USD_TO_VND))\n    budget_remaining = max(TOKEN_BUDGET_DAILY - tokens['total'], 0)\n    budget_remaining_pct = round((budget_remaining / TOKEN_BUDGET_DAILY) * 100, 1) if TOKEN_BUDGET_DAILY > 0 else 0.0\n\n    recs = []\n    if cpu > 80:\n        recs.append('CPU cao >80%: kiểm tra tiến trình tiêu tốn CPU và cân nhắc scale.')\n    if mem_pct > 85:\n        recs.append('RAM >85%: theo dõi memory leak, tăng swap hoặc nâng RAM.')\n    if disk_pct > 80:\n        recs.append('Disk >80%: cần dọn log/artifact hoặc mở rộng volume.')\n    if load1 > os.cpu_count():\n        recs.append('Load 1m vượt số core: có nguy cơ nghẽn xử lý.')\n    if blocker_count > 0:\n        recs.append(f'Có {blocker_count} mục blocker trong log gần nhất: ưu tiên xử lý ngay.')\n    if budget_remaining_pct < 20:\n        recs.append(f'Hạn mức token còn {budget_remaining_pct}%: cần theo dõi để tránh vượt ngân sách trong ngày.')\n    if not recs:\n        recs.append('Hệ thống ổn định. Duy trì theo dõi realtime mỗi 5 giây.')\n\n    chat = build_chat_messages(updates, limit=24)\n\n    return {\n        'timestamp': now,\n        'system': {\n            'cpuPercent': cpu,\n            'load': {'l1': round(load1, 2), 'l5': round(load5, 2), 'l15': round(load15, 2)},\n            'memory': {'total': mem_total, 'used': mem_used, 'available': mem_avail, 'usedPct': mem_pct},\n            'swap': {'total': swap_total, 'used': swap_used, 'free': swap_free, 'usedPct': swap_pct},\n            'disk': {'total': disk.total, 'used': disk.used, 'free': disk.free, 'usedPct': disk_pct},\n            'topProcesses': top_processes(),\n        },\n        'projects': {\n            'tokenToday': tokens,\n            'tokenBudget': {\n                'daily': TOKEN_BUDGET_DAILY,\n                'used': tokens['total'],\n                'remaining': budget_remaining,\n                'remainingPct': budget_remaining_pct,\n            },\n            'costEstimate': {\n                'usd': round(est_usd, 4),\n                'vnd': est_vnd,\n                'fxUsdToVnd': USD_TO_VND,\n                'rateInUsdPer1M': IN_USD_PER_1M,\n                'rateOutUsdPer1M': OUT_USD_PER_1M,\n            },\n            'ragCounts': rag_counts,\n            'blockerCount': blocker_count,\n            'updates': updates,\n            'updatesLight': chat,\n            'chat': chat,\n            'ownerActivity': owners,\n        },\n        'recommendations': recs,\n    }\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _is_authorized(self):\n        # Nếu không set password thì tạm thời mở (phục vụ local dev)\n        if not AUTH_PASS:\n            return True\n        auth = self.headers.get('Authorization', '')\n        if not auth.startswith('Basic '):\n            return False\n        try:\n            raw = base64.b64decode(auth.split(' ', 1)[1]).decode('utf-8', errors='ignore')\n            user, pw = raw.split(':', 1)\n            return user == AUTH_USER and pw == AUTH_PASS\n        except Exception:\n            return False\n\n    def _deny(self):\n        self.send_response(401)\n        self.send_header('WWW-Authenticate', 'Basic realm=\"Ops Cockpit\"')\n        self.end_headers()\n\n    def _json(self, data, code=200):\n        b = json.dumps(data, ensure_ascii=False).encode('utf-8')\n        self.send_response(code)\n        self.send_header('Content-Type', 'application/json; charset=utf-8')\n        self.send_header('Cache-Control', 'no-store')\n        self.send_header('Content-Length', str(len(b)))\n        self.end_headers()\n        self.wfile.write(b)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == '/health':\n            return self._json({'ok': True, 'time': datetime.now(timezone.utc).isoformat()})\n\n        if not self._is_authorized():\n            return self._deny()\n\n        if path == '/api/metrics':\n            return self._json(build_payload())\n\n        # static files\n        file_path = PUBLIC_DIR / ('index.html' if path == '/' else path.lstrip('/'))\n        if file_path.exists() and file_path.is_file() and str(file_path.resolve()).startswith(str(PUBLIC_DIR.resolve())):\n            ctype = 'text/html; charset=utf-8'\n            if file_path.suffix == '.js':\n                ctype = 'application/javascript; charset=utf-8'\n            elif file_path.suffix == '.css':\n                ctype = 'text/css; charset=utf-8'\n            content = file_path.read_bytes()\n            self.send_response(200)\n            self.send_header('Content-Type', ctype)\n            self.send_header('Content-Length', str(len(content)))\n            self.end_headers()\n            self.wfile.write(content)\n            return\n\n        self.send_response(404)\n        self.end_headers()\n\n\nif __name__ == '__main__':\n    port = int(os.environ.get('OPS_COCKPIT_PORT', '18888'))\n    server = ThreadingHTTPServer(('0.0.0.0', port), Handler)\n    print(f'Ops Cockpit running on :{port}')\n    server.serve_forever()\n"}],"isError":false,"timestamp":1776065314258}}
