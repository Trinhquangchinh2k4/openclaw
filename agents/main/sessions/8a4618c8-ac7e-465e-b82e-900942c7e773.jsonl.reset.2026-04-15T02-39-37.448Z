{"type":"message","id":"93db678d","parentId":"7ac54b34","timestamp":"2026-04-13T14:41:32.917Z","message":{"role":"toolResult","toolCallId":"call_8fQoJ0RqHybPKVhrxLKBLGSe|","toolName":"exec","content":[{"type":"text","text":"lines = []\n    if decision:\n        lines.append('• Quyết định: ' + _simplify_tech_phrase_vi(decision))\n    if owners:\n        lines.append('• Phụ trách: ' + _normalize_vi_phrase(owners))\n    if eta:\n        lines.append('• Hạn dự kiến: ' + _simplify_tech_phrase_vi(eta))\n    if blockers:\n        lines.append('• Vướng mắc: ' + _simplify_tech_phrase_vi(blockers))\n    if next_step:\n        lines.append('• Bước tiếp theo: ' + _simplify_tech_phrase_vi(next_step))\n    if evidence:\n        lines.append('• Bằng chứng: ' + _simplify_tech_phrase_vi(evidence))\n\n    if not lines:\n        fallback = summarize_non_technical_vi(t)\n        lines.append('• Tóm tắt kỹ thuật: ' + fallback)\n\n    detail = '\\n'.join(lines).strip()\n    return detail if detail else 'Không có chi tiết kỹ thuật bổ sung.'\n\n\ndef detect_speaker(text: str) -> str:\n    names = ['MINH AI', 'Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    pos = []\n    for n in names:\n        i = text.find(n)\n        if i != -1:\n            pos.append((i, n))\n    if pos:\n        pos.sort(key=lambda x: x[0])\n        return pos[0][1]\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef extract_owner_messages(text: str):\n    out = []\n    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': content})\n    return out\n\n\ndef humanize_owner_update(speaker: str, content: str) -> str:\n    c = _normalize_vi_phrase(content)\n    c = c.replace('OpenAPI', 'đặc tả API').replace('SLO', 'mục tiêu mức dịch vụ').replace('UAT', 'kiểm thử nghiệm thu')\n    c = c.replace('SIT', 'kiểm thử tích hợp hệ thống').replace('contract-test', 'kiểm thử hợp đồng giao tiếp')\n    if speaker == 'Mạnh AI':\n        return f'Em cập nhật nhanh: {c}.'\n    if speaker == 'Huy AI':\n        return f'Phần giao diện em đang xử lý: {c}.'\n    if speaker == 'Hà AI':\n        return f'Phần máy chủ em đang triển khai: {c}.'\n    if speaker == 'Huyền AI':\n        return f'Phần phân tích nghiệp vụ em đang theo dõi: {c}.'\n    return f'Em cập nhật: {c}.'\n\n\ndef humanize_preview(speaker: str, preview: str) -> str:\n    if 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.' in preview:\n        mapping = {\n            'Mạnh AI': 'Em đang bám sát tiến độ kỹ thuật tổng thể, có thay đổi em báo anh ngay.',\n            'Huy AI': 'Em đang rà soát giao diện và trải nghiệm người dùng, có bản mới em cập nhật liền.',\n            'Hà AI': 'Em đang theo dõi phần máy chủ và dữ liệu, có rủi ro em cảnh báo sớm cho anh.',\n            'Huyền AI': 'Em đang tổng hợp yêu cầu và tiêu chí nghiệm thu, để anh theo dõi dễ hơn.',\n            'MINH AI': 'Em đang điều phối tiến độ chung và theo dõi các điểm nghẽn theo thời gian thực.'\n        }\n        return mapping.get(speaker, preview)\n    return preview\n\n\ndef recent_internal_agent_messages(limit=10):\n    _ensure_sessions_loaded()\n    id_to_name = {\n        'main': 'MINH AI',\n        'manh': 'Mạnh AI',\n        'huy': 'Huy AI',\n        'ha': 'Hà AI',\n        'huyen': 'Huyền AI',\n    }\n    rows = []\n    try:\n        sessions = sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)\n        for s in sessions:\n            for m in (s.get('messages') or []):\n                if m.get('role') != 'assistant':\n                    continue\n                aid = (m.get('agentId') or 'main').strip().lower()\n                if aid not in id_to_name:\n                    continue\n                txt = (m.get('text') or '').strip()\n                if not txt:\n                    continue\n                ts = (m.get('ts') or '')\n                hhmm = ''\n                try:\n                    hhmm = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(timezone.utc).strftime('%H:%M UTC')\n                except Exception:\n                    hhmm = datetime.now(timezone.utc).strftime('%H:%M UTC')\n                rows.append({\n                    'speaker': id_to_name[aid],\n                    'time': hhmm,\n                    'text': txt,\n                    'detail': 'Nguồn: hội thoại trực tiếp tại khu chat với MINH AI.',\n                    'rag': 'GREEN'\n                })\n    except Exception:\n        return []"}],"details":{"status":"completed","exitCode":0,"durationMs":32,"aggregated":"lines = []\n    if decision:\n        lines.append('• Quyết định: ' + _simplify_tech_phrase_vi(decision))\n    if owners:\n        lines.append('• Phụ trách: ' + _normalize_vi_phrase(owners))\n    if eta:\n        lines.append('• Hạn dự kiến: ' + _simplify_tech_phrase_vi(eta))\n    if blockers:\n        lines.append('• Vướng mắc: ' + _simplify_tech_phrase_vi(blockers))\n    if next_step:\n        lines.append('• Bước tiếp theo: ' + _simplify_tech_phrase_vi(next_step))\n    if evidence:\n        lines.append('• Bằng chứng: ' + _simplify_tech_phrase_vi(evidence))\n\n    if not lines:\n        fallback = summarize_non_technical_vi(t)\n        lines.append('• Tóm tắt kỹ thuật: ' + fallback)\n\n    detail = '\\n'.join(lines).strip()\n    return detail if detail else 'Không có chi tiết kỹ thuật bổ sung.'\n\n\ndef detect_speaker(text: str) -> str:\n    names = ['MINH AI', 'Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    pos = []\n    for n in names:\n        i = text.find(n)\n        if i != -1:\n            pos.append((i, n))\n    if pos:\n        pos.sort(key=lambda x: x[0])\n        return pos[0][1]\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef extract_owner_messages(text: str):\n    out = []\n    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': content})\n    return out\n\n\ndef humanize_owner_update(speaker: str, content: str) -> str:\n    c = _normalize_vi_phrase(content)\n    c = c.replace('OpenAPI', 'đặc tả API').replace('SLO', 'mục tiêu mức dịch vụ').replace('UAT', 'kiểm thử nghiệm thu')\n    c = c.replace('SIT', 'kiểm thử tích hợp hệ thống').replace('contract-test', 'kiểm thử hợp đồng giao tiếp')\n    if speaker == 'Mạnh AI':\n        return f'Em cập nhật nhanh: {c}.'\n    if speaker == 'Huy AI':\n        return f'Phần giao diện em đang xử lý: {c}.'\n    if speaker == 'Hà AI':\n        return f'Phần máy chủ em đang triển khai: {c}.'\n    if speaker == 'Huyền AI':\n        return f'Phần phân tích nghiệp vụ em đang theo dõi: {c}.'\n    return f'Em cập nhật: {c}.'\n\n\ndef humanize_preview(speaker: str, preview: str) -> str:\n    if 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.' in preview:\n        mapping = {\n            'Mạnh AI': 'Em đang bám sát tiến độ kỹ thuật tổng thể, có thay đổi em báo anh ngay.',\n            'Huy AI': 'Em đang rà soát giao diện và trải nghiệm người dùng, có bản mới em cập nhật liền.',\n            'Hà AI': 'Em đang theo dõi phần máy chủ và dữ liệu, có rủi ro em cảnh báo sớm cho anh.',\n            'Huyền AI': 'Em đang tổng hợp yêu cầu và tiêu chí nghiệm thu, để anh theo dõi dễ hơn.',\n            'MINH AI': 'Em đang điều phối tiến độ chung và theo dõi các điểm nghẽn theo thời gian thực.'\n        }\n        return mapping.get(speaker, preview)\n    return preview\n\n\ndef recent_internal_agent_messages(limit=10):\n    _ensure_sessions_loaded()\n    id_to_name = {\n        'main': 'MINH AI',\n        'manh': 'Mạnh AI',\n        'huy': 'Huy AI',\n        'ha': 'Hà AI',\n        'huyen': 'Huyền AI',\n    }\n    rows = []\n    try:\n        sessions = sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)\n        for s in sessions:\n            for m in (s.get('messages') or []):\n                if m.get('role') != 'assistant':\n                    continue\n                aid = (m.get('agentId') or 'main').strip().lower()\n                if aid not in id_to_name:\n                    continue\n                txt = (m.get('text') or '').strip()\n                if not txt:\n                    continue\n                ts = (m.get('ts') or '')\n                hhmm = ''\n                try:\n                    hhmm = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(timezone.utc).strftime('%H:%M UTC')\n                except Exception:\n                    hhmm = datetime.now(timezone.utc).strftime('%H:%M UTC')\n                rows.append({\n                    'speaker': id_to_name[aid],\n                    'time': hhmm,\n                    'text': txt,\n                    'detail': 'Nguồn: hội thoại trực tiếp tại khu chat với MINH AI.',\n                    'rag': 'GREEN'\n                })\n    except Exception:\n        return []","cwd":"/home/openclaw_user/.openclaw/workspace"},"isError":false,"timestamp":1776091292900}}
