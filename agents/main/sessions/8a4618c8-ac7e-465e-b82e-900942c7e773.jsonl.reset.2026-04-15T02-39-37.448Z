{"type":"message","id":"eadacf42","parentId":"1c2149a9","timestamp":"2026-04-13T10:38:28.970Z","message":{"role":"toolResult","toolCallId":"call_x9Ze73uo1N29fixqvlgP7fpJ|","toolName":"read","content":[{"type":"text","text":"                saved = save_base64_image(image_data, prefix=source)\n                if not saved:\n                    return self._json({'ok': False, 'error': 'Dữ liệu ảnh không hợp lệ hoặc vượt quá dung lượng cho phép'}, code=400)\n                url = f\"/uploads/{saved}\"\n                return self._json({'ok': True, 'file': saved, 'url': url})\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        if path == '/api/upload-document':\n            try:\n                length = int(self.headers.get('Content-Length', '0'))\n                raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n                body = json.loads(raw or '{}')\n                file_data = body.get('fileData') or ''\n                file_name = body.get('fileName') or 'tai-lieu'\n                source = body.get('source') or 'doc'\n                saved = save_base64_file(file_data, file_name=file_name, prefix=source)\n                if not saved:\n                    return self._json({'ok': False, 'error': 'Tài liệu không hợp lệ, định dạng chưa hỗ trợ hoặc vượt quá dung lượng'}, code=400)\n                url = f\"/uploads/{saved}\"\n                return self._json({'ok': True, 'file': saved, 'url': url})\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        if path == '/api/chat-sessions':\n            try:\n                length = int(self.headers.get('Content-Length', '0'))\n                raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n                body = json.loads(raw or '{}')\n                name = (body.get('name') or '').strip()\n                with CHAT_SESSIONS_LOCK:\n                    session = create_session(name)\n                    sessions = list_chat_sessions_meta()\n                return self._json({'ok': True, 'session': session, 'sessions': sessions})\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        if path == '/api/minh-chat':\n            try:\n                length = int(self.headers.get('Content-Length', '0'))\n                raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n                body = json.loads(raw or '{}')\n                msg = (body.get('message') or '').strip()\n                attachments = body.get('attachments') or []\n                session_id = (body.get('sessionId') or '').strip() or None\n                agent_id = (body.get('agentId') or 'main').strip().lower()\n                allowed_agents = {'main', 'manh', 'huy', 'ha', 'huyen'}\n                if agent_id not in allowed_agents:\n                    agent_id = 'main'\n                with CHAT_SESSIONS_LOCK:\n                    s = append_chat_message(session_id, 'user', msg, attachments=attachments)\n                    gateway_map = s.get('gatewaySessionByAgent')\n                    if not isinstance(gateway_map, dict):\n                        gateway_map = {}\n                    gateway_session = gateway_map.get(agent_id)\n                    if not gateway_session:\n                        gateway_session = str(uuid4())\n                        gateway_map[agent_id] = gateway_session\n                        s['gatewaySessionByAgent'] = gateway_map\n                        save_chat_sessions(CHAT_MEMORY)\n\n                    try:\n                        reply = ask_minh_via_openclaw(msg, gateway_session, agent_id=agent_id, attachments=attachments)\n                    except Exception as ex:\n                        print(f'[minh-chat] openclaw fallback: {ex}')\n                        # fallback nhanh để tránh đợi lâu khi pipeline agent bị chậm\n                        reply = generate_agent_fallback(agent_id, msg, attachments=attachments)\n\n                    s = append_chat_message(s.get('id'), 'assistant', reply, attachments=[], agent_id=agent_id)\n                    sessions = list_chat_sessions_meta()\n                return self._json({\n                    'ok': True,\n                    'reply': reply,\n                    'voice': {'lang': 'vi-VN', 'gender': 'female'},\n                    'agentId': agent_id,\n                    'sessionId': s.get('id'),\n                    'memorySize': len(s.get('messages', [])),\n                    'history': s.get('messages', [])[-40:],\n                    'sessions': sessions\n                })\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        self.send_response(404)\n        self.end_headers()\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n        q = parse_qs(parsed.query or '')\n\n        if path == '/health':\n            return self._json({'ok': True, 'time': datetime.now(timezone.utc).isoformat()})\n\n        if not self._is_authorized():\n            return self._deny()\n\n        if path == '/api/metrics':\n            return self._json(build_payload())\n\n        if path == '/api/chat-sessions':\n            with CHAT_SESSIONS_LOCK:\n                return self._json({'ok': True, 'sessions': list_chat_sessions_meta()})\n\n        if path == '/api/chat-history':\n            session_id = (q.get('sessionId', [''])[0] or '').strip() or None\n            with CHAT_SESSIONS_LOCK:\n                s = get_session(session_id)\n                return self._json({\n                    'ok': True,\n                    'sessionId': s.get('id'),\n                    'sessionName': s.get('name') or 'Phiên chat',\n                    'history': (s.get('messages') or [])[-80:],\n                    'sessions': list_chat_sessions_meta()\n                })\n\n        if path.startswith('/uploads/'):\n            fp = UPLOAD_DIR / path.replace('/uploads/', '', 1)\n            if fp.exists() and fp.is_file() and str(fp.resolve()).startswith(str(UPLOAD_DIR.resolve())):\n                ext = fp.suffix.lower()\n\n[52 more lines in file. Use offset=1060 to continue.]"}],"isError":false,"timestamp":1776076708965}}
{"type":"message","id":"820cc562","parentId":"eadacf42","timestamp":"2026-04-13T10:38:37.750Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"\",\"summary\":[],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_bNLHyV8pJr6Me2bpyTinOeck|","name":"read","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","offset":540,"limit":180},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"offset\":540,\"limit\":180}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":1420,"output":355,"cacheRead":171392,"cacheWrite":0,"totalTokens":173167,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776076708983,"responseId":""}}
{"type":"message","id":"fc497d65","parentId":"820cc562","timestamp":"2026-04-13T10:38:37.775Z","message":{"role":"toolResult","toolCallId":"call_bNLHyV8pJr6Me2bpyTinOeck|","toolName":"read","content":[{"type":"text","text":"    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': content})\n    return out\n\n\ndef humanize_owner_update(speaker: str, content: str) -> str:\n    c = _normalize_vi_phrase(content)\n    c = c.replace('OpenAPI', 'đặc tả API').replace('SLO', 'mục tiêu mức dịch vụ').replace('UAT', 'kiểm thử nghiệm thu')\n    c = c.replace('SIT', 'kiểm thử tích hợp hệ thống').replace('contract-test', 'kiểm thử hợp đồng giao tiếp')\n    if speaker == 'Mạnh AI':\n        return f'Em cập nhật nhanh: {c}.'\n    if speaker == 'Huy AI':\n        return f'Phần giao diện em đang xử lý: {c}.'\n    if speaker == 'Hà AI':\n        return f'Phần máy chủ em đang triển khai: {c}.'\n    if speaker == 'Huyền AI':\n        return f'Phần phân tích nghiệp vụ em đang theo dõi: {c}.'\n    return f'Em cập nhật: {c}.'\n\n\ndef humanize_preview(speaker: str, preview: str) -> str:\n    if 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.' in preview:\n        mapping = {\n            'Mạnh AI': 'Em đang bám sát tiến độ kỹ thuật tổng thể, có thay đổi em báo anh ngay.',\n            'Huy AI': 'Em đang rà soát giao diện và trải nghiệm người dùng, có bản mới em cập nhật liền.',\n            'Hà AI': 'Em đang theo dõi phần máy chủ và dữ liệu, có rủi ro em cảnh báo sớm cho anh.',\n            'Huyền AI': 'Em đang tổng hợp yêu cầu và tiêu chí nghiệm thu, để anh theo dõi dễ hơn.',\n            'MINH AI': 'Em đang điều phối tiến độ chung và theo dõi các điểm nghẽn theo thời gian thực.'\n        }\n        return mapping.get(speaker, preview)\n    return preview\n\n\ndef build_chat_messages(updates, limit=20):\n    msgs = []\n    for u in updates[-limit:]:\n        raw = u.get('text', '')\n        m = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', raw)\n        if m:\n            ts, body = m.group(1), m.group(2)\n        else:\n            ts, body = '', raw\n        body_vi = to_vietnamese_text(body)\n        detail = extract_technical_details_vi(body_vi)\n\n        owner_msgs = extract_owner_messages(body_vi)\n        if owner_msgs:\n            for om in owner_msgs:\n                msgs.append({\n                    'speaker': om['speaker'],\n                    'time': ts,\n                    'text': humanize_owner_update(om['speaker'], om['text']),\n                    'detail': detail,\n                    'rag': u.get('rag', 'GREEN')\n                })\n            continue\n\n        speaker = detect_speaker(body_vi)\n        preview = summarize_non_technical_vi(body_vi)\n        preview = humanize_preview(speaker, preview)\n        msgs.append({\n            'speaker': speaker,\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n\n    # Bổ sung hiện diện hội thoại cho đủ các bot chủ chốt nếu thiếu trong dữ liệu gần nhất\n    required = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    present = {m.get('speaker') for m in msgs}\n    for name in required:\n        if name not in present:\n            msgs.append({\n                'speaker': name,\n                'time': datetime.now(timezone.utc).strftime('%H:%M UTC'),\n                'text': 'Em đang theo dõi hạng mục được giao và sẽ cập nhật tiến độ bằng tiếng Việt.',\n                'detail': '• Quyết định: Duy trì cập nhật minh bạch theo nhịp thời gian thực.\\n• Bước tiếp theo: Gửi báo cáo ngắn khi có thay đổi trạng thái.',\n                'rag': 'GREEN'\n            })\n    return msgs\n\n\ndef parse_priority_blockers(updates, limit=8):\n    items = []\n    for u in updates:\n        txt = u.get('text', '')\n        ts = ''\n        m_time = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', txt)\n        body = txt\n        if m_time:\n            ts, body = m_time.group(1), m_time.group(2)\n\n        speaker = detect_speaker(to_vietnamese_text(body))\n\n        m = re.search(r'(Blockers:|Vướng mắc:)(.*?)(Next:|Bước tiếp theo:|$)', body, re.IGNORECASE)\n        if not m:\n            continue\n        raw = m.group(2).strip(' .;')\n        raw_vi = _normalize_vi_phrase(to_vietnamese_text(raw))\n        low = raw_vi.lower()\n\n        if not raw_vi or low in {'none', 'không có'} or low.startswith('không có'):\n            continue\n\n        severity = 'AMBER'\n        if any(k in low for k in ['blocked', 'đang chờ', 'không xác nhận', 'chưa xác nhận', 'missing', 'thiếu', 'password', 'không có quyền']):\n            severity = 'RED'\n\n        text_view = _simplify_tech_phrase_vi(raw_vi)\n        if text_view == 'Nội dung kỹ thuật đã được chuẩn hóa và ghi nhận trong hệ thống theo dõi.':\n            text_view = 'Có vướng mắc cần ưu tiên xử lý, vui lòng mở bối cảnh để xem chi tiết quyết định.'\n\n        items.append({\n            'time': ts,\n            'speaker': speaker,\n            'text': text_view,\n            'severity': severity,\n            'source': summarize_non_technical_vi(to_vietnamese_text(body)),\n            'raw': raw_vi,\n        })\n\n    def rank(x):\n        sev = 2 if x['severity'] == 'RED' else 1\n        return (sev, x.get('time', ''))\n\n    items.sort(key=rank, reverse=True)\n    return items[:limit]\n\n\ndef top_processes():\n    try:\n        out = subprocess.check_output(\n            \"ps -eo comm,%cpu,%mem --sort=-%cpu | head -n 8\",\n            shell=True,\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n        rows = []\n        for ln in out.splitlines()[1:]:\n            parts = ln.split()\n            if len(parts) >= 3:\n                rows.append({'name': parts[0], 'cpu': float(parts[1]), 'mem': float(parts[2])})\n        return rows\n    except Exception:\n        return []\n\n\ndef build_payload():\n    now = datetime.now(timezone.utc).isoformat()\n    cpu = cpu_usage_percent()\n    load1, load5, load15 = os.getloadavg()\n    mem = mem_info()\n\n    mem_total = mem.get('MemTotal', 0)\n    mem_avail = mem.get('MemAvailable', 0)\n    mem_used = max(mem_total - mem_avail, 0)\n    mem_pct = round((mem_used / mem_total * 100), 1) if mem_total else 0\n\n    swap_total = mem.get('SwapTotal', 0)\n    swap_free = mem.get('SwapFree', 0)\n    swap_used = max(swap_total - swap_free, 0)\n    swap_pct = round((swap_used / swap_total * 100), 1) if swap_total else 0\n\n    disk = shutil.disk_usage('/')\n    disk_pct = round((disk.used / disk.total * 100), 1)\n\n    tokens = token_stats_today()\n    updates = parse_team_updates()\n\n[392 more lines in file. Use offset=720 to continue.]"}],"isError":false,"timestamp":1776076717766}}
