{"type":"message","id":"f597a021","parentId":"438ae40a","timestamp":"2026-04-13T14:59:13.172Z","message":{"role":"toolResult","toolCallId":"call_RwVYUq3cFhhSAXQbR3X1mLR3|","toolName":"read","content":[{"type":"text","text":"function renderSessionOptions(sessions=[]){\n  const sel=document.getElementById('chatSessionSelect');\n  if(!sel) return;\n  sel.innerHTML = (sessions||[]).map(s=>`<option value=\"${s.id}\">${s.name} (${s.messageCount||0} tin)</option>`).join('');\n  if(currentSessionId){ sel.value = currentSessionId; }\n  sel.onchange = ()=>{ currentSessionId = sel.value; loadChatHistory(); };\n}\n\nasync function loadChatSessions(){\n  try{\n    const res = await fetch('/api/chat-sessions');\n    const data = await res.json();\n    if(!data.ok) return;\n    if(!currentSessionId && data.sessions && data.sessions.length){\n      currentSessionId = data.sessions[0].id;\n    }\n    renderSessionOptions(data.sessions||[]);\n  }catch(e){\n    appendVoiceLine('assistant','Dạ em không tải được danh sách phiên chat. Anh tải lại trang giúp em ạ.');\n  }\n}\n\nasync function loadChatHistory(){\n  try{\n    if(!currentSessionId){ await loadChatSessions(); }\n    const q = currentSessionId ? ('?sessionId='+encodeURIComponent(currentSessionId)) : '';\n    const res = await fetch('/api/chat-history'+q);\n    const data = await res.json();\n    if(!data.ok) return;\n    currentSessionId = data.sessionId || currentSessionId;\n    renderSessionOptions(data.sessions||[]);\n    renderVoiceHistory(data.history||[]);\n    const box=document.getElementById('voiceTranscript');\n    if(box) box.style.display='block';\n    const btn=document.getElementById('toggleHistoryBtn');\n    if(btn) btn.textContent='Ẩn lịch sử';\n  }catch(e){\n    appendVoiceLine('assistant','Dạ em chưa tải được lịch sử chat, anh bấm tải lại trang giúp em ạ.');\n  }\n}\n\nasync function createNewSession(){\n  try{\n    const name = prompt('Đặt tên phiên chat mới (có thể để trống):') || '';\n    const res = await fetch('/api/chat-sessions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});\n    const data = await res.json();\n    if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa tạo được phiên chat mới ạ.'); return; }\n    currentSessionId = data.session?.id || currentSessionId;\n    renderSessionOptions(data.sessions||[]);\n    renderVoiceHistory([]);\n  }catch(e){\n    appendVoiceLine('assistant','Dạ có lỗi khi tạo phiên chat mới, anh thử lại giúp em ạ.');\n  }\n}\n\nasync function askMinh(message){\n  try{\n    const selectedAgent = (document.getElementById('agentSelect')?.value || 'main').trim();\n    showPending(selectedAgent);\n    const sendBtn=document.getElementById('sendBtn');\n    if(sendBtn) sendBtn.disabled=true;\n    const payload = {message, attachments: chatAttachments, sessionId: currentSessionId, agentId: selectedAgent};\n    const res = await fetch('/api/minh-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n    const data = await res.json();\n    clearPending();\n    if(!data.ok){ appendVoiceLine('assistant','Dạ em xin lỗi anh, em chưa xử lý được yêu cầu này ạ.'); return; }\n    currentSessionId = data.sessionId || currentSessionId;\n    renderSessionOptions(data.sessions||[]);\n    renderVoiceHistory(data.history||[]);\n    speakText(data.reply);\n    chatAttachments=[];\n  }catch(e){\n    clearPending();\n    appendVoiceLine('assistant','Dạ đang lỗi kết nối chat. Anh bấm tải lại trang (Ctrl+F5) hoặc tạo phiên chat mới giúp em ạ.');\n  }finally{\n    const sendBtn=document.getElementById('sendBtn');\n    if(sendBtn) sendBtn.disabled=false;\n  }\n}\n\nasync function uploadBase64Image(imageData, source='upload'){\n  const res = await fetch('/api/upload-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({imageData, source})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa nhận được ảnh hợp lệ ạ.'); return; }\n  chatAttachments.push({type:'image', url:data.url});\n  appendVoiceLine('user',`[Đã đính kèm ảnh] ${data.url}`);\n}\n\nasync function uploadBase64Document(fileData, fileName, source='doc'){\n  const res = await fetch('/api/upload-document',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fileData, fileName, source})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa nhận được tài liệu hợp lệ (pdf/doc/docx/txt/csv/xlsx/json) hoặc tệp quá nặng ạ.'); return; }\n  chatAttachments.push({type:'document', url:data.url, name:fileName||'tai-lieu'});\n  appendVoiceLine('user',`[Đã gửi tài liệu] ${fileName||'tai-lieu'} -> ${data.url}`);\n}\n\nfunction pickImage(){ document.getElementById('imgPicker').click(); }\nfunction pickDocument(){ document.getElementById('docPicker').click(); }\n\nfunction uploadPickedImage(ev){\n  const f = ev.target.files && ev.target.files[0];\n  if(!f) return;\n  const rd = new FileReader();\n  rd.onload = ()=> uploadBase64Image(rd.result, 'picker');\n  rd.readAsDataURL(f);\n  ev.target.value='';\n}\n\nfunction uploadPickedDocument(ev){\n  const f = ev.target.files && ev.target.files[0];\n  if(!f) return;\n  const rd = new FileReader();\n  rd.onload = ()=> uploadBase64Document(rd.result, f.name, 'doc');\n  rd.readAsDataURL(f);\n  ev.target.value='';\n}\n\nasync function captureImage(){\n  const video=document.getElementById('camPreview');\n  const canvas=document.getElementById('camCanvas');\n\n  if(!camStream){\n    try{\n      camStream = await navigator.mediaDevices.getUserMedia({video:true});\n      video.srcObject = camStream;\n      video.style.display='block';\n      appendVoiceLine('assistant','Dạ em đã bật camera. Anh bấm lại nút Chụp ảnh để chụp ạ.');\n      return;\n    }catch(e){\n      appendVoiceLine('assistant','Dạ em không mở được camera, anh kiểm tra quyền truy cập giúp em ạ.');\n      return;\n    }\n  }\n\n  const w = video.videoWidth || 640;\n  const h = video.videoHeight || 480;\n  canvas.width=w; canvas.height=h;\n  const ctx=canvas.getContext('2d');\n  ctx.drawImage(video,0,0,w,h);\n  const dataUrl = canvas.toDataURL('image/png');\n  await uploadBase64Image(dataUrl, 'camera');\n}\n\nfunction speakText(text, retry=false){\n  if(!text) return;\n  if(!window.speechSynthesis){\n    appendVoiceLine('assistant','Dạ trình duyệt không hỗ trợ phát giọng nói ạ.');\n    return;\n  }\n  speechSynthesis.cancel();\n  speechSynthesis.resume();\n  speaking=true;\n  if(recog && listening){\n    try{recog.stop();}catch(e){}\n  }\n  const chunks = splitSpeechChunks(text);\n  if(!chunks.length) return;\n\n  let idx = 0;\n  const v = pickVietnameseVoice();\n  let started=false;\n  const startGuard = setTimeout(()=>{\n    if(started) return;\n    speaking=false;\n    if(!retry){\n      // Thu gọn nội dung để thử lại nhanh khi engine TTS bị kẹt.\n      speakText(text.slice(0, 220), true);\n      return;\n    }\n    if(voiceEnabled){\n      document.getElementById('voiceState').textContent='Trạng thái: không phát được âm thanh, anh bấm lại Bật hội thoại rảnh tay giúp em.';\n      startContinuousListening();\n    }\n  }, 1700);\n\n  const speakNext = ()=>{\n    const chunk = chunks[idx++];\n    if(!chunk){\n      clearTimeout(startGuard);\n      speaking=false;\n      if(voiceEnabled){\n        startContinuousListening();\n      }else{\n        document.getElementById('voiceState').textContent='Trạng thái: tắt';\n      }\n      return;\n    }\n\n    const u = new SpeechSynthesisUtterance(chunk);\n    u.lang='vi-VN';\n    const p = chunkProsody(chunk, idx - 1);\n    u.rate=p.rate;\n    u.pitch=p.pitch;\n    u.volume=1;\n    if(v) u.voice=v;\n\n    u.onstart = ()=>{\n      started=true;\n      clearTimeout(startGuard);\n      document.getElementById('voiceState').textContent='Trạng thái: MINH AI đang nói';\n    };\n    u.onend = ()=>{\n      setTimeout(speakNext, 70);\n    };\n    u.onerror = ()=>{\n      clearTimeout(startGuard);\n      speaking=false;\n      if(voiceEnabled){\n        if(!retry){\n          speakText(text.slice(0, 220), true);\n        }else{\n          document.getElementById('voiceState').textContent='Trạng thái: lỗi phát âm thanh';\n          startContinuousListening();\n        }\n      }\n    };\n    speechSynthesis.speak(u);\n  };\n\n  speakNext();\n\n[211 more lines in file. Use offset=520 to continue.]"}],"isError":false,"timestamp":1776092353163}}
{"type":"message","id":"3454eba7","parentId":"f597a021","timestamp":"2026-04-13T14:59:18.352Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_mtSxNUCKizcB6vR5FEKIQvRj|","name":"read","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/public/index.html","offset":520,"limit":240},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/public/index.html\",\"offset\":520,\"limit\":240}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":2369,"output":44,"cacheRead":63744,"cacheWrite":0,"totalTokens":66157,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776092353183,"responseId":""}}
{"type":"message","id":"ab8f08ae","parentId":"3454eba7","timestamp":"2026-04-13T14:59:18.375Z","message":{"role":"toolResult","toolCallId":"call_mtSxNUCKizcB6vR5FEKIQvRj|","toolName":"read","content":[{"type":"text","text":"}\n\nfunction initRecognition(){\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n  if(!SR) return null;\n  const r = new SR();\n  r.lang='vi-VN';\n  r.continuous=true;\n  r.interimResults=true;\n  r.onresult = (e)=>{\n    let finalText='';\n    let interim='';\n    for(let i=e.resultIndex;i<e.results.length;i++){\n      const res=e.results[i];\n      const txt=res?.[0]?.transcript||'';\n      if(!txt) continue;\n      if(res.isFinal) finalText += txt+' ';\n      else interim += txt+' ';\n    }\n    if(interim.trim()){\n      document.getElementById('voiceState').textContent='Trạng thái: đang nghe... '+interim.trim();\n    }\n    const clean=finalText.trim();\n    if(clean && !speaking){\n      appendVoiceLine('user',clean);\n      askMinh(clean);\n    }\n  };\n  r.onerror = ()=>{\n    listening=false;\n    if(voiceEnabled && !speaking){\n      document.getElementById('voiceState').textContent='Trạng thái: lỗi mic, đang thử nghe lại...';\n      scheduleRestartListening();\n    }else if(!voiceEnabled){\n      document.getElementById('voiceState').textContent='Trạng thái: tắt';\n    }\n  };\n  r.onend = ()=>{\n    listening=false;\n    if(voiceEnabled && !speaking){\n      scheduleRestartListening();\n    }\n  };\n  return r;\n}\n\nfunction scheduleRestartListening(){\n  if(restartingRecognition) return;\n  restartingRecognition=true;\n  setTimeout(()=>{\n    restartingRecognition=false;\n    startContinuousListening();\n  }, 450);\n}\n\nfunction startContinuousListening(){\n  if(!voiceEnabled || speaking) return;\n  if(!recog){\n    recog=initRecognition();\n  }\n  if(!recog){\n    appendVoiceLine('assistant','Dạ trình duyệt chưa hỗ trợ nhận giọng nói liên tục ạ. Anh dùng ô nhập chữ giúp em nhé.');\n    voiceEnabled=false;\n    document.getElementById('voiceBtn').textContent='Bật hội thoại rảnh tay';\n    document.getElementById('voiceState').textContent='Trạng thái: tắt';\n    return;\n  }\n  if(listening) return;\n  try{\n    recog.start();\n    listening=true;\n    document.getElementById('voiceState').textContent='Trạng thái: đang nghe liên tục...';\n  }catch(e){}\n}\n\nfunction toggleVoice(){\n  voiceEnabled=!voiceEnabled;\n  document.getElementById('voiceBtn').textContent = voiceEnabled ? 'Tắt hội thoại rảnh tay' : 'Bật hội thoại rảnh tay';\n  if(voiceEnabled){\n    primeSpeech();\n    appendVoiceLine('assistant','Dạ em đã bật chế độ rảnh tay: em sẽ nghe liên tục và phản hồi bằng giọng nữ tiếng Việt ạ.');\n    startContinuousListening();\n  }else{\n    speaking=false;\n    speechSynthesis.cancel();\n    if(recog && listening){\n      try{recog.stop();}catch(e){}\n    }\n    listening=false;\n    document.getElementById('voiceState').textContent='Trạng thái: tắt';\n  }\n}\n\nfunction testSpeaker(){\n  primeSpeech();\n  speakText('Dạ em nghe rõ anh ạ. Nếu anh nghe được câu này thì loa đang hoạt động tốt.');\n}\n\nif(window.speechSynthesis){\n  loadVoices();\n  window.speechSynthesis.onvoiceschanged = ()=>{ loadVoices(); };\n}\n\nfunction sendTyped(){\n  const el=document.getElementById('voiceText');\n  const txt=(el.value||'').trim();\n  if(!txt) return;\n  appendVoiceLine('user',txt);\n  el.value='';\n  askMinh(txt);\n}\n\ndocument.getElementById('voiceText').addEventListener('keydown',(e)=>{\n  if(e.key==='Enter' && !e.shiftKey){\n    e.preventDefault();\n    sendTyped();\n  }\n});\n\nasync function tick(){\n  const r=await fetch('/api/metrics');\n  const d=await r.json();\n  document.getElementById('ts').textContent='Cập nhật: '+new Date(d.timestamp).toLocaleString();\n  document.getElementById('cpu').textContent=d.system.cpuPercent+'%';\n  document.getElementById('ram').textContent=d.system.memory.usedPct+'%';\n  document.getElementById('tok').textContent=fmtNumber(d.projects.tokenToday.total);\n  document.getElementById('blk').textContent=d.projects.blockerCount;\n\n  const b=d.projects.tokenBudget||{};\n  const c=d.projects.costEstimate||{};\n  document.getElementById('tokRemainPct').textContent=(b.remainingPct??0)+'%';\n  document.getElementById('tokRemainAbs').textContent=fmtNumber(b.remaining||0);\n  document.getElementById('costVnd').textContent=fmtNumber(c.vnd||0)+' VND';\n  document.getElementById('costUsd').textContent=(c.usd??0).toFixed(4)+' USD';\n\n  const label=new Date().toLocaleTimeString();\n  sysChart.data.labels.push(label);\n  sysChart.data.datasets[0].data.push(d.system.cpuPercent);\n  sysChart.data.datasets[1].data.push(d.system.memory.usedPct);\n  sysChart.data.datasets[2].data.push(d.system.disk.usedPct);\n  if(sysChart.data.labels.length>30){\n    sysChart.data.labels.shift();\n    sysChart.data.datasets.forEach(x=>x.data.shift());\n  }\n  sysChart.update();\n\n  document.getElementById('rag').innerHTML=`\n    <div><span class=\"pill p-green\">GREEN ${d.projects.ragCounts.GREEN||0}</span>\n    <span class=\"pill p-amber\">AMBER ${d.projects.ragCounts.AMBER||0}</span>\n    <span class=\"pill p-red\">RED ${d.projects.ragCounts.RED||0}</span></div>`;\n\n  const owners=d.projects.ownerActivity;\n  const labels=Object.keys(owners), values=Object.values(owners);\n  if(!ownerChart){\n    ownerChart=new Chart(ownerCtx,{type:'bar',data:{labels,datasets:[{label:'Tần suất cập nhật theo người phụ trách',data:values,backgroundColor:'#8b5cf6'}]},options:{animation:false}})\n  }else{\n    ownerChart.data.labels=labels; ownerChart.data.datasets[0].data=values; ownerChart.update();\n  }\n\n  document.getElementById('proc').innerHTML=d.system.topProcesses.map(p=>`<tr><td>${p.name}</td><td>${p.cpu}</td><td>${p.mem}</td></tr>`).join('');\n  document.getElementById('recs').innerHTML=d.recommendations.map(x=>`<li>${x}</li>`).join('');\n\n  const pb=(d.projects.priorityBlockers||[]);\n  document.getElementById('blockers').innerHTML = pb.length\n    ? pb.map((b,i)=>`<div class=\"blk ${b.severity==='RED'?'sev-red':'sev-amber'}\"><div class=\"meta\"><b>[${b.severity}]</b> ${b.speaker} ${b.time?('· '+b.time):''}</div><div>${b.text}</div><button class=\"btn\" onclick=\"toggleDetail('pb${i}', this)\">Xem thêm bối cảnh</button><div class=\"detail\" id=\"pb${i}\">Nguồn: ${b.source}\\nChi tiết ghi nhận: ${b.raw||b.text}</div></div>`).join('')\n    : '<div class=\"sub\">Hiện chưa có vướng mắc ưu tiên cần xử lý.</div>';\n  const updatesLight=(d.projects.updatesLight||[]).slice(-12).reverse();\n  document.getElementById('updates').innerHTML=updatesLight.map(u=>`<li class=\"${ragClass(u.rag)}\">[${u.rag}] ${u.time?u.time+': ':''}${u.text}</li>`).join('');\n\n  const chat=(d.projects.chat||[]).slice(-14).reverse();\n  document.getElementById('chat').innerHTML=chat.map((c,i)=>`<div class=\"msg\"><div class=\"meta\">${c.speaker} ${c.time?('· '+c.time):''} <span class=\"${ragClass(c.rag)}\">[${c.rag}]</span></div><div>${c.text}</div><button class=\"btn\" onclick=\"toggleDetail('d${i}', this)\">Xem thêm chi tiết kỹ thuật</button><div class=\"detail\" id=\"d${i}\">${c.detail||'Không có chi tiết.'}</div></div>`).join('');\n}\n\nfunction toggleDetail(id, btn){\n  const el=document.getElementById(id);\n  if(!el) return;\n  const open = el.style.display==='block';\n  el.style.display = open ? 'none' : 'block';\n  if(btn){ btn.textContent = open ? 'Xem thêm chi tiết kỹ thuật' : 'Ẩn chi tiết kỹ thuật'; }\n}\n\nfunction toggleUpdates(btn){\n  const el=document.getElementById('updates');\n  if(!el) return;\n  const open = el.style.display !== 'none';\n  el.style.display = open ? 'none' : 'block';\n  btn.textContent = open ? 'Hiện mục này' : 'Ẩn mục này';\n}\n\nfunction toggleBlockers(btn){\n  const el=document.getElementById('blockers');\n  if(!el) return;\n  const open = el.style.display !== 'none';\n  el.style.display = open ? 'none' : 'block';\n  btn.textContent = open ? 'Hiện mục này' : 'Ẩn mục này';\n}\n\nfunction toggleHistoryPane(btn){\n  const el=document.getElementById('voiceTranscript');\n  if(!el) return;\n  const open = el.style.display !== 'none';\n  el.style.display = open ? 'none' : 'block';\n  btn.textContent = open ? 'Hiện lịch sử' : 'Ẩn lịch sử';\n}\n\nloadChatSessions().then(loadChatHistory);\ntick();\nsetInterval(tick,5000);\n</script>\n</body>\n</html>"}],"isError":false,"timestamp":1776092358368}}
