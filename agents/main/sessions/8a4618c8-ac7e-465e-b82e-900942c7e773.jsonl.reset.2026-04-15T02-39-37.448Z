{"type":"message","id":"dc57c688","parentId":"225504c3","timestamp":"2026-04-13T10:38:17.311Z","message":{"role":"toolResult","toolCallId":"call_jwnKDjIjBPYStw9WPE0xQDiK|","toolName":"read","content":[{"type":"text","text":"\n    sid = uuid4().hex[:12]\n    return [{\n        'id': sid,\n        'name': _default_session_name(),\n        'createdAt': _now_iso(),\n        'updatedAt': _now_iso(),\n        'messages': []\n    }]\n\n\ndef save_chat_sessions(sessions):\n    CHAT_SESSIONS_FILE.parent.mkdir(parents=True, exist_ok=True)\n    payload = {'sessions': sessions}\n    CHAT_SESSIONS_FILE.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')\n\n\ndef _ensure_sessions_loaded():\n    global CHAT_MEMORY\n    if isinstance(CHAT_MEMORY, list) and CHAT_MEMORY and isinstance(CHAT_MEMORY[0], dict) and CHAT_MEMORY[0].get('id'):\n        return\n    CHAT_MEMORY = load_chat_sessions()\n\n\ndef list_chat_sessions_meta():\n    _ensure_sessions_loaded()\n    out = []\n    for s in CHAT_MEMORY:\n        msgs = s.get('messages') or []\n        out.append({\n            'id': s.get('id'),\n            'name': s.get('name') or 'Phiên chat',\n            'createdAt': s.get('createdAt'),\n            'updatedAt': s.get('updatedAt'),\n            'messageCount': len(msgs)\n        })\n    out.sort(key=lambda x: x.get('updatedAt') or '', reverse=True)\n    return out\n\n\ndef get_session(session_id=None):\n    _ensure_sessions_loaded()\n    if session_id:\n        for s in CHAT_MEMORY:\n            if s.get('id') == session_id:\n                return s\n    if CHAT_MEMORY:\n        return sorted(CHAT_MEMORY, key=lambda x: x.get('updatedAt') or '', reverse=True)[0]\n    sid = uuid4().hex[:12]\n    s = {'id': sid, 'name': _default_session_name(), 'createdAt': _now_iso(), 'updatedAt': _now_iso(), 'messages': []}\n    CHAT_MEMORY.append(s)\n    return s\n\n\ndef create_session(name=''):\n    _ensure_sessions_loaded()\n    sid = uuid4().hex[:12]\n    n = (name or '').strip() or _default_session_name()\n    now = _now_iso()\n    s = {'id': sid, 'name': n, 'createdAt': now, 'updatedAt': now, 'messages': []}\n    CHAT_MEMORY.append(s)\n    save_chat_sessions(CHAT_MEMORY)\n    return s\n\n\ndef append_chat_message(session_id, role, text, attachments=None, agent_id=None):\n    s = get_session(session_id)\n    msg = {\n        'role': role,\n        'text': text,\n        'attachments': attachments or [],\n        'ts': _now_iso(),\n        'agentId': agent_id or ''\n    }\n    messages = s.setdefault('messages', [])\n    messages.append(msg)\n    if len(messages) > 200:\n        del messages[:-200]\n    s['updatedAt'] = _now_iso()\n    save_chat_sessions(CHAT_MEMORY)\n    return s\n\n\ndef _extract_openclaw_text(payload):\n    try:\n        if not isinstance(payload, dict):\n            return ''\n        result = payload.get('result') or {}\n        items = result.get('payloads') or []\n        lines = []\n        for it in items:\n            txt = (it or {}).get('text') if isinstance(it, dict) else None\n            if txt:\n                lines.append(str(txt).strip())\n        return '\\n\\n'.join([x for x in lines if x])\n    except Exception:\n        return ''\n\n\ndef ask_minh_via_openclaw(user_text: str, session_id: str, agent_id: str = 'main', attachments=None):\n    msg = (user_text or '').strip()\n    if attachments:\n        imgs = []\n        for a in attachments:\n            if isinstance(a, dict) and a.get('type') == 'image' and a.get('url'):\n                imgs.append(str(a.get('url')))\n        if imgs:\n            msg = msg + '\\n\\n[Ảnh đính kèm từ web]\\n' + '\\n'.join(f'- {u}' for u in imgs)\n\n    if not msg:\n        return ''\n\n    cmd = [\n        OPENCLAW_BIN,\n        'agent',\n        '--agent',\n        (agent_id or 'main'),\n        '--session-id',\n        session_id,\n        '--message',\n\n[932 more lines in file. Use offset=180 to continue.]"}],"isError":false,"timestamp":1776076697305}}
