getUserMedia({video:true});\n+177       video.srcObject = camStream;\n+178       video.style.display='block';\n+179       appendVoiceLine('assistant','Dạ em đã bật camera. Anh bấm lại nút Chụp ảnh để chụp ạ.');\n+180       return;\n+181     }catch(e){\n+182       appendVoiceLine('assistant','Dạ em không mở được camera, anh kiểm tra quyền truy cập giúp em ạ.');\n+183       return;\n+184     }\n+185   }\n+186 \n+187   const w = video.videoWidth || 640;\n+188   const h = video.videoHeight || 480;\n+189   canvas.width=w; canvas.height=h;\n+190   const ctx=canvas.getContext('2d');\n+191   ctx.drawImage(video,0,0,w,h);\n+192   const dataUrl = canvas.toDataURL('image/png');\n+193   await uploadBase64Image(dataUrl, 'camera');\n+194 }\n+195 \n 141 function speakText(text){\n 142   const u = new SpeechSynthesisUtterance(text);\n 143   u.lang='vi-VN';\n 144   u.rate=1.0; u.pitch=1.15;\n     ...","firstChangedLine":48},"isError":false,"timestamp":1776067820073}}
