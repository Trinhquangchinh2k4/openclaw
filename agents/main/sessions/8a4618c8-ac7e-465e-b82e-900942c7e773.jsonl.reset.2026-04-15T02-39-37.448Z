{"type":"message","id":"6eea2fe4","parentId":"075a396d","timestamp":"2026-04-13T06:53:34.550Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"\",\"summary\":[],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_yNeIMlIPbLz3J8B85FzzwcAj|","name":"read","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","offset":1,"limit":260},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"offset\":1,\"limit\":260}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":2260,"output":455,"cacheRead":48128,"cacheWrite":0,"totalTokens":50843,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776063204397,"responseId":""}}
{"type":"message","id":"2027a20f","parentId":"6eea2fe4","timestamp":"2026-04-13T06:53:34.630Z","message":{"role":"toolResult","toolCallId":"call_yNeIMlIPbLz3J8B85FzzwcAj|","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport time\nfrom datetime import datetime, timezone\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nWORKSPACE = Path('/home/openclaw_user/.openclaw/workspace')\nTEAM_LOGS = WORKSPACE / 'team_logs'\nSESSIONS_META = Path('/home/openclaw_user/.openclaw/agents/main/sessions/sessions.json')\nPUBLIC_DIR = Path(__file__).parent / 'public'\n\nCPU_LAST = None\nCPU_LAST_TS = None\n\n\ndef read_text(path: Path) -> str:\n    try:\n        return path.read_text(encoding='utf-8', errors='ignore')\n    except Exception:\n        return ''\n\n\ndef cpu_usage_percent():\n    global CPU_LAST, CPU_LAST_TS\n    try:\n        with open('/proc/stat', 'r', encoding='utf-8') as f:\n            line = f.readline()\n        parts = [float(x) for x in line.strip().split()[1:]]\n        idle = parts[3] + parts[4]\n        total = sum(parts)\n        now = time.time()\n        if CPU_LAST is None:\n            CPU_LAST = (idle, total)\n            CPU_LAST_TS = now\n            return 0.0\n        prev_idle, prev_total = CPU_LAST\n        delta_idle = idle - prev_idle\n        delta_total = total - prev_total\n        CPU_LAST = (idle, total)\n        CPU_LAST_TS = now\n        if delta_total <= 0:\n            return 0.0\n        return round(100.0 * (1.0 - delta_idle / delta_total), 1)\n    except Exception:\n        return 0.0\n\n\ndef mem_info():\n    out = {}\n    try:\n        with open('/proc/meminfo', 'r', encoding='utf-8') as f:\n            for line in f:\n                k, v = line.split(':', 1)\n                out[k.strip()] = int(v.strip().split()[0]) * 1024\n    except Exception:\n        pass\n    return out\n\n\ndef get_session_file():\n    try:\n        data = json.loads(read_text(SESSIONS_META) or '{}')\n        if not data:\n            return None\n        # ưu tiên session telegram direct của anh Minh\n        key = None\n        for k in data.keys():\n            if 'telegram:direct:1079299777' in k:\n                key = k\n                break\n        if key is None:\n            key = next(iter(data.keys()))\n        sf = data[key].get('sessionFile')\n        return Path(sf) if sf else None\n    except Exception:\n        return None\n\n\ndef token_stats_today():\n    session_file = get_session_file()\n    if not session_file or not session_file.exists():\n        return {'in': 0, 'out': 0, 'total': 0, 'messages': 0}\n\n    today = datetime.now(timezone.utc).date().isoformat()\n    token_in = 0\n    token_out = 0\n    count = 0\n    try:\n        with session_file.open('r', encoding='utf-8', errors='ignore') as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                try:\n                    obj = json.loads(line)\n                except Exception:\n                    continue\n                ts = obj.get('timestamp', '')\n                if not ts.startswith(today):\n                    continue\n                msg = obj.get('message', {})\n                usage = msg.get('usage', {})\n                i = usage.get('input', 0) or 0\n                o = usage.get('output', 0) or 0\n                if i or o:\n                    token_in += int(i)\n                    token_out += int(o)\n                    count += 1\n    except Exception:\n        pass\n    return {'in': token_in, 'out': token_out, 'total': token_in + token_out, 'messages': count}\n\n\ndef parse_team_updates(limit=25):\n    files = sorted(TEAM_LOGS.glob('*.md'))\n    if not files:\n        return []\n    latest = files[-1]\n    lines = read_text(latest).splitlines()\n    updates = []\n    for ln in lines:\n        if ln.startswith('- '):\n            text = ln[2:].strip()\n            rag = 'GREEN'\n            up = text.upper()\n            if 'RAG: RED' in up or ' RED ' in up:\n                rag = 'RED'\n            elif 'RAG: AMBER' in up or ' AMBER' in up:\n                rag = 'AMBER'\n            updates.append({'text': text, 'rag': rag})\n    return updates[-limit:]\n\n\ndef owner_activity(updates):\n    owners = {'Mạnh AI': 0, 'Huy AI': 0, 'Hà AI': 0, 'Huyền AI': 0, 'MINH AI': 0}\n    for u in updates:\n        t = u['text']\n        for name in list(owners.keys()):\n            if name in t:\n                owners[name] += 1\n    return owners\n\n\ndef top_processes():\n    try:\n        out = subprocess.check_output(\n            \"ps -eo comm,%cpu,%mem --sort=-%cpu | head -n 8\",\n            shell=True,\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n        rows = []\n        for ln in out.splitlines()[1:]:\n            parts = ln.split()\n            if len(parts) >= 3:\n                rows.append({'name': parts[0], 'cpu': float(parts[1]), 'mem': float(parts[2])})\n        return rows\n    except Exception:\n        return []\n\n\ndef build_payload():\n    now = datetime.now(timezone.utc).isoformat()\n    cpu = cpu_usage_percent()\n    load1, load5, load15 = os.getloadavg()\n    mem = mem_info()\n\n    mem_total = mem.get('MemTotal', 0)\n    mem_avail = mem.get('MemAvailable', 0)\n    mem_used = max(mem_total - mem_avail, 0)\n    mem_pct = round((mem_used / mem_total * 100), 1) if mem_total else 0\n\n    swap_total = mem.get('SwapTotal', 0)\n    swap_free = mem.get('SwapFree', 0)\n    swap_used = max(swap_total - swap_free, 0)\n    swap_pct = round((swap_used / swap_total * 100), 1) if swap_total else 0\n\n    disk = shutil.disk_usage('/')\n    disk_pct = round((disk.used / disk.total * 100), 1)\n\n    tokens = token_stats_today()\n    updates = parse_team_updates()\n    owners = owner_activity(updates)\n\n    rag_counts = {'GREEN': 0, 'AMBER': 0, 'RED': 0}\n    blocker_count = 0\n    for u in updates:\n        rag_counts[u['rag']] = rag_counts.get(u['rag'], 0) + 1\n        if 'blocker' in u['text'].lower() or 'blocked' in u['text'].lower():\n            blocker_count += 1\n\n    recs = []\n    if cpu > 80:\n        recs.append('CPU cao >80%: kiểm tra tiến trình tiêu tốn CPU và cân nhắc scale.')\n    if mem_pct > 85:\n        recs.append('RAM >85%: theo dõi memory leak, tăng swap hoặc nâng RAM.')\n    if disk_pct > 80:\n        recs.append('Disk >80%: cần dọn log/artifact hoặc mở rộng volume.')\n    if load1 > os.cpu_count():\n        recs.append('Load 1m vượt số core: có nguy cơ nghẽn xử lý.')\n    if blocker_count > 0:\n        recs.append(f'Có {blocker_count} mục blocker trong log gần nhất: ưu tiên xử lý ngay.')\n    if not recs:\n        recs.append('Hệ thống ổn định. Duy trì theo dõi realtime mỗi 5 giây.')\n\n    return {\n        'timestamp': now,\n        'system': {\n            'cpuPercent': cpu,\n            'load': {'l1': round(load1, 2), 'l5': round(load5, 2), 'l15': round(load15, 2)},\n            'memory': {'total': mem_total, 'used': mem_used, 'available': mem_avail, 'usedPct': mem_pct},\n            'swap': {'total': swap_total, 'used': swap_used, 'free': swap_free, 'usedPct': swap_pct},\n            'disk': {'total': disk.total, 'used': disk.used, 'free': disk.free, 'usedPct': disk_pct},\n            'topProcesses': top_processes(),\n        },\n        'projects': {\n            'tokenToday': tokens,\n            'ragCounts': rag_counts,\n            'blockerCount': blocker_count,\n            'updates': updates,\n            'ownerActivity': owners,\n        },\n        'recommendations': recs,\n    }\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _json(self, data, code=200):\n        b = json.dumps(data, ensure_ascii=False).encode('utf-8')\n        self.send_response(code)\n        self.send_header('Content-Type', 'application/json; charset=utf-8')\n        self.send_header('Cache-Control', 'no-store')\n        self.send_header('Content-Length', str(len(b)))\n        self.end_headers()\n        self.wfile.write(b)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n        if path == '/api/metrics':\n            return self._json(build_payload())\n\n        if path == '/health':\n            return self._json({'ok': True, 'time': datetime.now(timezone.utc).isoformat()})\n\n        # static files\n        file_path = PUBLIC_DIR / ('index.html' if path == '/' else path.lstrip('/'))\n        if file_path.exists() and file_path.is_file() and str(file_path.resolve()).startswith(str(PUBLIC_DIR.resolve())):\n            ctype = 'text/html; charset=utf-8'\n            if file_path.suffix == '.js':\n                ctype = 'application/javascript; charset=utf-8'\n            elif file_path.suffix == '.css':\n                ctype = 'text/css; charset=utf-8'\n            content = file_path.read_bytes()\n\n[17 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1776063214614}}
{"type":"message","id":"c62e9e61","parentId":"2027a20f","timestamp":"2026-04-13T06:53:43.560Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"\",\"summary\":[],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_IqAen8f81tUpIzwyqFMXZyXZ|","name":"read","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","offset":261,"limit":120},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"offset\":261,\"limit\":120}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":2363,"output":302,"cacheRead":50304,"cacheWrite":0,"totalTokens":52969,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776063214777,"responseId":""}}
{"type":"message","id":"47e3aba2","parentId":"c62e9e61","timestamp":"2026-04-13T06:53:43.587Z","message":{"role":"toolResult","toolCallId":"call_IqAen8f81tUpIzwyqFMXZyXZ|","toolName":"read","content":[{"type":"text","text":"            self.send_response(200)\n            self.send_header('Content-Type', ctype)\n            self.send_header('Content-Length', str(len(content)))\n            self.end_headers()\n            self.wfile.write(content)\n            return\n\n        self.send_response(404)\n        self.end_headers()\n\n\nif __name__ == '__main__':\n    port = int(os.environ.get('OPS_COCKPIT_PORT', '18888'))\n    server = ThreadingHTTPServer(('0.0.0.0', port), Handler)\n    print(f'Ops Cockpit running on :{port}')\n    server.serve_forever()\n"}],"isError":false,"timestamp":1776063223583}}
{"type":"message","id":"d10e98a5","parentId":"47e3aba2","timestamp":"2026-04-13T06:54:00.631Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"\",\"summary\":[],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_xNkzbMHYmsFqqVAZowGNkWhJ|","name":"edit","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","edits":[{"oldText":"import json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport time\nfrom datetime import datetime, timezone\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n","newText":"import base64\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport time\nfrom datetime import datetime, timezone\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n"},{"oldText":"CPU_LAST = None\nCPU_LAST_TS = None\n","newText":"CPU_LAST = None\nCPU_LAST_TS = None\n\nAUTH_USER = os.environ.get('OPS_COCKPIT_USER', 'minh')\nAUTH_PASS = os.environ.get('OPS_COCKPIT_PASS', '')\n"},{"oldText":"class Handler(BaseHTTPRequestHandler):\n    def _json(self, data, code=200):\n","newText":"class Handler(BaseHTTPRequestHandler):\n    def _is_authorized(self):\n        # Nếu không set password thì tạm thời mở (phục vụ local dev)\n        if not AUTH_PASS:\n            return True\n        auth = self.headers.get('Authorization', '')\n        if not auth.startswith('Basic '):\n            return False\n        try:\n            raw = base64.b64decode(auth.split(' ', 1)[1]).decode('utf-8', errors='ignore')\n            user, pw = raw.split(':', 1)\n            return user == AUTH_USER and pw == AUTH_PASS\n        except Exception:\n            return False\n\n    def _deny(self):\n        self.send_response(401)\n        self.send_header('WWW-Authenticate', 'Basic realm=\"Ops Cockpit\"')\n        self.end_he