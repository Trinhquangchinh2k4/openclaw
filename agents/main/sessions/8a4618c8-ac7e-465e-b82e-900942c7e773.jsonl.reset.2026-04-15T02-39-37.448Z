utton class=\"btn\" onclick=\"sendTyped()\">Gửi MINH AI</button>\n        <button class=\"btn\" onclick=\"pickImage()\">Đính kèm ảnh</button>\n        <button class=\"btn\" onclick=\"captureImage()\">Chụp ảnh</button>\n      </div>\n      <input type=\"file\" id=\"imgPicker\" accept=\"image/*\" style=\"display:none\" onchange=\"uploadPickedImage(event)\" />\n      <video id=\"camPreview\" autoplay playsinline style=\"display:none;width:280px;margin-top:8px;border-radius:8px;border:1px solid #374067\"></video>\n      <canvas id=\"camCanvas\" style=\"display:none\"></canvas>\n    </div>\n    <div id=\"voiceTranscript\" class=\"detail\" style=\"display:block;margin-top:8px\"></div>\n  </div>\n"},{"oldText":"let ownerChart=null;\nlet recog=null;\nlet voiceEnabled=false;\nlet speaking=false;\n","newText":"let ownerChart=null;\nlet recog=null;\nlet voiceEnabled=false;\nlet speaking=false;\nlet chatAttachments=[];\nlet camStream=null;\n"},{"oldText":"async function askMinh(message){\n  const res = await fetch('/api/minh-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em xin lỗi anh, em chưa xử lý được yêu cầu này ạ.'); return; }\n  appendVoiceLine('assistant',data.reply);\n  speakText(data.reply);\n}\n","newText":"async function askMinh(message){\n  const res = await fetch('/api/minh-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message, attachments: chatAttachments})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em xin lỗi anh, em chưa xử lý được yêu cầu này ạ.'); return; }\n  appendVoiceLine('assistant',data.reply);\n  speakText(data.reply);\n  chatAttachments=[];\n}\n\nasync function uploadBase64Image(imageData, source='upload'){\n  const res = await fetch('/api/upload-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({imageData, source})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa nhận được ảnh hợp lệ ạ.'); return; }\n  chatAttachments.push({type:'image', url:data.url});\n  appendVoiceLine('user',`[Đã đính kèm ảnh] ${data.url}`);\n}\n\nfunction pickImage(){ document.getElementById('imgPicker').click(); }\n\nfunction uploadPickedImage(ev){\n  const f = ev.target.files && ev.target.files[0];\n  if(!f) return;\n  const rd = new FileReader();\n  rd.onload = ()=> uploadBase64Image(rd.result, 'picker');\n  rd.readAsDataURL(f);\n  ev.target.value='';\n}\n\nasync function captureImage(){\n  const video=document.getElementById('camPreview');\n  const canvas=document.getElementById('camCanvas');\n\n  if(!camStream){\n    try{\n      camStream = await navigator.mediaDevices.getUserMedia({video:true});\n      video.srcObject = camStream;\n      video.style.display='block';\n      appendVoiceLine('assistant','Dạ em đã bật camera. Anh bấm lại nút Chụp ảnh để chụp ạ.');\n      return;\n    }catch(e){\n      appendVoiceLine('assistant','Dạ em không mở được camera, anh kiểm tra quyền truy cập giúp em ạ.');\n      return;\n    }\n  }\n\n  const w = video.videoWidth || 640;\n  const h = video.videoHeight || 480;\n  canvas.width=w; canvas.height=h;\n  const ctx=canvas.getContext('2d');\n  ctx.drawImage(video,0,0,w,h);\n  const dataUrl = canvas.toDataURL('image/png');\n  await uploadBase64Image(dataUrl, 'camera');\n}\n"}]},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/public/index.html\",\"edits\":[{\"oldText\":\"  <div class=\\\"card\\\" style=\\\"margin-bottom:12px\\\">\\n    <h4>🎙️ Hội thoại giọng nói với MINH AI</h4>\\n    <div style=\\\"display:flex;gap:8px;flex-wrap:wrap;align-items:center\\\">\\n      <button class=\\\"btn\\\" id=\\\"voiceBtn\\\" onclick=\\\"toggleVoice()\\\">Bắt đầu hội thoại</button>\\n      <button class=\\\"btn\\\" id=\\\"speakBtn\\\" onclick=\\\"startTalk()\\\">Giữ để nói</button>\\n      <span 