{"type":"message","id":"972d6b10","parentId":"5d748da1","timestamp":"2026-04-13T07:24:33.495Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"\",\"summary\":[],\"type\":\"reasoning\"}"},{"type":"toolCall","id":"call_kmckDSh7EKPIvkkotkfnDjCA|","name":"edit","arguments":{"path":"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py","edits":[{"oldText":"def detect_speaker(text: str) -> str:\n    order = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI', 'MINH AI']\n    for n in order:\n        if n in text:\n            return n\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef build_chat_messages(updates, limit=20):\n    msgs = []\n    for u in updates[-limit:]:\n        raw = u.get('text', '')\n        m = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', raw)\n        if m:\n            ts, body = m.group(1), m.group(2)\n        else:\n            ts, body = '', raw\n        body_vi = to_vietnamese_text(body)\n        preview = summarize_non_technical_vi(body_vi)\n        detail = extract_technical_details_vi(body_vi)\n        msgs.append({\n            'speaker': detect_speaker(body_vi),\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n    return msgs\n","newText":"def detect_speaker(text: str) -> str:\n    names = ['MINH AI', 'Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI']\n    pos = []\n    for n in names:\n        i = text.find(n)\n        if i != -1:\n            pos.append((i, n))\n    if pos:\n        pos.sort(key=lambda x: x[0])\n        return pos[0][1]\n    if 'User' in text or 'Anh Minh' in text:\n        return 'Anh Minh'\n    return 'MINH AI'\n\n\ndef extract_owner_messages(text: str):\n    out = []\n    m = re.search(r'(Owners\\s*&\\s*ETA:|Phụ trách\\s*&\\s*Hạn dự kiến:)(.*?)(Blockers:|Vướng mắc:|$)', text, re.IGNORECASE)\n    if not m:\n        return out\n    body = m.group(2).strip()\n    parts = [p.strip(' .') for p in body.split(';') if p.strip()]\n    for p in parts:\n        m2 = re.match(r'^(Mạnh AI|Huy AI|Hà AI|Huyền AI|MINH AI)\\s*(.*)$', p)\n        if not m2:\n            continue\n        speaker = m2.group(1)\n        content = m2.group(2).strip(' .,:')\n        if content:\n            out.append({'speaker': speaker, 'text': f'Em cập nhật: {content}.'})\n    return out\n\n\ndef build_chat_messages(updates, limit=20):\n    msgs = []\n    for u in updates[-limit:]:\n        raw = u.get('text', '')\n        m = re.match(r'^(\\d{2}:\\d{2}(?:–\\d{2}:\\d{2})?\\sUTC)\\s*[:\\-]\\s*(.*)$', raw)\n        if m:\n            ts, body = m.group(1), m.group(2)\n        else:\n            ts, body = '', raw\n        body_vi = to_vietnamese_text(body)\n        detail = extract_technical_details_vi(body_vi)\n\n        owner_msgs = extract_owner_messages(body_vi)\n        if owner_msgs:\n            for om in owner_msgs:\n                msgs.append({\n                    'speaker': om['speaker'],\n                    'time': ts,\n                    'text': _simplify_tech_phrase_vi(om['text']),\n                    'detail': detail,\n                    'rag': u.get('rag', 'GREEN')\n                })\n            continue\n\n        preview = summarize_non_technical_vi(body_vi)\n        msgs.append({\n            'speaker': detect_speaker(body_vi),\n            'time': ts,\n            'text': preview,\n            'detail': detail,\n            'rag': u.get('rag', 'GREEN')\n        })\n    return msgs\n"}]},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/server.py\",\"edits\":[{\"oldText\":\"def detect_speaker(text: str) -> str:\\n    order = ['Mạnh AI', 'Huy AI', 'Hà AI', 'Huyền AI', 'MINH AI']\\n    for n in order:\\n        if n in text:\\n            return n\\n    if 'User' in text or 'Anh Minh' in text:\\n        return 'Anh Minh'\\n    return 'MINH AI'\\n\\