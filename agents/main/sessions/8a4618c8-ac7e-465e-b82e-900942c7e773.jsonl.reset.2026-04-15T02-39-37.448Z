te_sheet('TIEN_DO')\nnow=datetime.utcnow().strftime('%Y-%m-%d %H:%M UTC')\nws['A1']='BÁO CÁO TIẾN ĐỘ TẠM THỜI'\nws['A2']='Thời điểm'\nws['B2']=now\nws['A3']='Số ngân hàng có file dữ liệu'\nws['B3']=len(done_codes)\nws['A4']='Tổng số ngân hàng theo template'\nws['B4']=30\nws['A5']='Tiến độ %'\nws['B5']=round((len(done_codes)/30)*100,1)\nws['A7']='Ngân hàng đã có dữ liệu'\nws['B7']='File nguồn đã tải'\nrow=8\nfor code in done_codes:\n    ws.cell(row=row,column=1,value=code)\n    linked=[p.name for p in files if (code=='VCB' and p.name.startswith('VCB_')) or (code=='TCB' and (p.name.startswith('fy25-') or p.name.startswith('bao-cao-thuong-nien-nam-2024') or 'techcombank' in p.name.lower()))]\n    ws.cell(row=row,column=2,value='; '.join(linked) if linked else '')\n    row+=1\n\nif not done_codes:\n    ws['A8']='Chưa có ngân hàng nào tải dữ liệu thành công.'\n\nout=outdir/f'ket-qua-tam-thoi-bank-annual-{datetime.utcnow().strftime(\"%Y%m%d-%H%M%S\")}.xlsx'\nwb.save(out)\nprint(out)\nprint('DONE_CODES',','.join(done_codes) if done_codes else 'NONE')\nprint('DATA_FILES',len(files))\nPY"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nfrom openpyxl import load_workbook\\nfrom pathlib import Path\\nfrom datetime import datetime\\nimport shutil\\n\\nbase=Path('/home/openclaw_user/.openclaw/workspace')\\ntpl=Path('/home/openclaw_user/.openclaw/media/inbound/template_order---ca63da35-5fda-4563-a641-81eb22dace8b.xlsx')\\noutdir=base/'ops_cockpit'/'uploads'\\noutdir.mkdir(parents=True,exist_ok=True)\\nwork=base/'financial_reports_annual_2024_2025'\\n\\n# detect current data files and bank codes from names\\nfiles=sorted([p for p in work.glob('*') if p.suffix.lower() in ['.pdf','.xlsx','.xls','.csv']]) if work.exists() else []\\ndone_codes=[]\\nfor p in files:\\n    name=p.name\\n    if name.startswith('VCB_'):\\n        done_codes.append('VCB')\\n    if 'techcombank' in name.lower() or name.startswith('fy25-') or name.startswith('bao-cao-thuong-nien-nam-2024'):\\n        done_codes.append('TCB')\\n# unique keep order\\nu=[]\\nfor x in done_codes:\\n    if x not in u: u.append(x)\\ndone_codes=u\\n\\nwb=load_workbook(tpl)\\nif 'TIEN_DO' in wb.sheetnames:\\n    del wb['TIEN_DO']\\nws=wb.create_sheet('TIEN_DO')\\nnow=datetime.utcnow().strftime('%Y-%m-%d %H:%M UTC')\\nws['A1']='BÁO CÁO TIẾN ĐỘ TẠM THỜI'\\nws['A2']='Thời điểm'\\nws['B2']=now\\nws['A3']='Số ngân hàng có file dữ liệu'\\nws['B3']=len(done_codes)\\nws['A4']='Tổng số ngân hàng theo template'\\nws['B4']=30\\nws['A5']='Tiến độ %'\\nws['B5']=round((len(done_codes)/30)*100,1)\\nws['A7']='Ngân hàng đã có dữ liệu'\\nws['B7']='File nguồn đã tải'\\nrow=8\\nfor code in done_codes:\\n    ws.cell(row=row,column=1,value=code)\\n    linked=[p.name for p in files if (code=='VCB' and p.name.startswith('VCB_')) or (code=='TCB' and (p.name.startswith('fy25-') or p.name.startswith('bao-cao-thuong-nien-nam-2024') or 'techcombank' in p.name.lower()))]\\n    ws.cell(row=row,column=2,value='; '.join(linked) if linked else '')\\n    row+=1\\n\\nif not done_codes:\\n    ws['A8']='Chưa có ngân hàng nào tải dữ liệu thành công.'\\n\\nout=outdir/f'ket-qua-tam-thoi-bank-annual-{datetime.utcnow().strftime(\\\"%Y%m%d-%H%M%S\\\")}.xlsx'\\nwb.save(out)\\nprint(out)\\nprint('DONE_CODES',','.join(done_codes) if done_codes else 'NONE')\\nprint('DATA_FILES',len(files))\\nPY\"}"}],"api":"openai-responses","provider":"github-copilot","model":"gpt-5.3-codex","usage":{"input":390,"output":1230,"cacheRead":241920,"cacheWrite":0,"totalTokens":243540,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1776089032377,"responseId":""}}
