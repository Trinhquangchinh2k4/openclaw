{"type":"message","id":"0f9a33a8","parentId":"1c38be00","timestamp":"2026-04-13T08:33:17.505Z","message":{"role":"toolResult","toolCallId":"call_gJ2QwSJzGsmCxcxmoaYrnxs5|","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\nimport base64\nimport json\nimport os\nimport re\nimport shutil\nimport ssl\nimport subprocess\nimport time\nfrom datetime import datetime, timezone\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom urllib.parse import urlparse\n\nCHAT_MEMORY = []\n\nWORKSPACE = Path('/home/openclaw_user/.openclaw/workspace')\nUPLOAD_DIR = Path('/home/openclaw_user/.openclaw/workspace/ops_cockpit/uploads')\nUPLOAD_DIR.mkdir(parents=True, exist_ok=True)\nTEAM_LOGS = WORKSPACE / 'team_logs'\nSESSIONS_META = Path('/home/openclaw_user/.openclaw/agents/main/sessions/sessions.json')\nPUBLIC_DIR = Path(__file__).parent / 'public'\n\nCPU_LAST = None\nCPU_LAST_TS = None\n\nAUTH_USER = os.environ.get('OPS_COCKPIT_USER', 'minh')\nAUTH_PASS = os.environ.get('OPS_COCKPIT_PASS', '')\n\nTOKEN_BUDGET_DAILY = int(os.environ.get('OPS_TOKEN_BUDGET_DAILY', '1000000'))\nUSD_TO_VND = float(os.environ.get('OPS_USD_TO_VND', '26000'))\nIN_USD_PER_1M = float(os.environ.get('OPS_IN_USD_PER_1M', '5'))\nOUT_USD_PER_1M = float(os.environ.get('OPS_OUT_USD_PER_1M', '15'))\n\n\ndef read_text(path: Path) -> str:\n    try:\n        return path.read_text(encoding='utf-8', errors='ignore')\n    except Exception:\n        return ''\n\n\ndef cpu_usage_percent():\n    global CPU_LAST, CPU_LAST_TS\n    try:\n        with open('/proc/stat', 'r', encoding='utf-8') as f:\n            line = f.readline()\n        parts = [float(x) for x in line.strip().split()[1:]]\n        idle = parts[3] + parts[4]\n        total = sum(parts)\n        now = time.time()\n        if CPU_LAST is None:\n            CPU_LAST = (idle, total)\n            CPU_LAST_TS = now\n            return 0.0\n        prev_idle, prev_total = CPU_LAST\n        delta_idle = idle - prev_idle\n        delta_total = total - prev_total\n        CPU_LAST = (idle, total)\n        CPU_LAST_TS = now\n        if delta_total <= 0:\n            return 0.0\n        return round(100.0 * (1.0 - delta_idle / delta_total), 1)\n    except Exception:\n        return 0.0\n\n\ndef mem_info():\n    out = {}\n    try:\n        with open('/proc/meminfo', 'r', encoding='utf-8') as f:\n            for line in f:\n                k, v = line.split(':', 1)\n                out[k.strip()] = int(v.strip().split()[0]) * 1024\n    except Exception:\n        pass\n    return out\n\n\ndef get_session_file():\n    try:\n        data = json.loads(read_text(SESSIONS_META) or '{}')\n        if not data:\n            return None\n        # ưu tiên session telegram direct của anh Minh\n        key = None\n        for k in data.keys():\n            if 'telegram:direct:1079299777' in k:\n                key = k\n                break\n        if key is None:\n            key = next(iter(data.keys()))\n        sf = data[key].get('sessionFile')\n        return Path(sf) if sf else None\n    except Exception:\n        return None\n\n\ndef token_stats_today():\n    session_file = get_session_file()\n    if not session_file or not session_file.exists():\n        return {'in': 0, 'out': 0, 'total': 0, 'messages': 0}\n\n    today = datetime.now(timezone.utc).date().isoformat()\n    token_in = 0\n    token_out = 0\n    count = 0\n    try:\n        with session_file.open('r', encoding='utf-8', errors='ignore') as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                try:\n                    obj = json.loads(line)\n                except Exception:\n                    continue\n                ts = obj.get('timestamp', '')\n                if not ts.startswith(today):\n                    continue\n                msg = obj.get('message', {})\n                usage = msg.get('usage', {})\n                i = usage.get('input', 0) or 0\n                o = usage.get('output', 0) or 0\n                if i or o:\n                    token_in += int(i)\n                    token_out += int(o)\n                    count += 1\n    except Exception:\n        pass\n    return {'in': token_in, 'out': token_out, 'total': token_in + token_out, 'messages': count}\n\n\ndef parse_team_updates(limit=25):\n    files = sorted(TEAM_LOGS.glob('*.md'))\n    if not files:\n        return []\n    latest = files[-1]\n    lines = read_text(latest).splitlines()\n    updates = []\n    for ln in lines:\n        if ln.startswith('- '):\n            text = ln[2:].strip()\n            rag = 'GREEN'\n            up = text.upper()\n            if 'RAG: RED' in up or ' RED ' in up:\n                rag = 'RED'\n            elif 'RAG: AMBER' in up or ' AMBER' in up:\n                rag = 'AMBER'\n            updates.append({'text': text, 'rag': rag})\n    return updates[-limit:]\n\n\ndef owner_activity(updates):\n    owners = {'Mạnh AI': 0, 'Huy AI': 0, 'Hà AI': 0, 'Huyền AI': 0, 'MINH AI': 0}\n    for u in updates:\n        t = u['text']\n        for name in list(owners.keys()):\n            if name in t:\n                owners[name] += 1\n    return owners\n\n\ndef to_vietnamese_text(text: str) -> str:\n    repl = {\n        'Decision:': 'Quyết định:',\n        'Owners:': 'Phụ trách:',\n        'Owner:': 'Phụ trách:',\n        'Blockers:': 'Vướng mắc:',\n        'Next:': 'Bước tiếp theo:',\n        'ETA:': 'Hạn dự kiến:',\n        'Evidence:': 'Bằng chứng:',\n        'Execution completed successfully': 'Thực thi hoàn tất thành công',\n        'requested': 'yêu cầu',\n        'approved': 'đã phê duyệt',\n        'service running': 'dịch vụ đang chạy',\n        'pending': 'đang chờ',\n        'User asked': 'Anh Minh hỏi',\n        'User requested': 'Anh Minh yêu cầu',\n        'User approved': 'Anh Minh đã phê duyệt',\n        'User confirmed': 'Anh Minh xác nhận',\n        'keep overall delivery': 'giữ trạng thái triển khai tổng thể',\n        'completed hardening package': 'đã hoàn tất gói hardening',\n        'feature delivered': 'đã bàn giao tính năng',\n        'manh/huy/ha/huyen': 'Mạnh AI/Huy AI/Hà AI/Huyền AI',\n        'manh': 'Mạnh',\n        'huyen': 'Huyền',\n        'ha': 'Hà',\n        'huy': 'Huy',\n        'done now': 'hoàn tất ngay',\n        'frontend': 'giao diện',\n        'backend': 'phía máy chủ',\n        'payload': 'gói dữ liệu',\n        'deployment': 'triển khai',\n        'acceptance': 'nghiệm thu',\n    }\n    out = text\n    for k, v in repl.items():\n        out = out.replace(k, v)\n    return out\n\n\ndef summarize_non_technical_vi(text: str) -> str:\n    cleaned = text\n    for mk in [' Bằng chứng:', ' Vướng mắc:', ' Hạn dự kiến:', ' Bước tiếp theo:', ' RAG:', ' Quyết định:', ' Phụ trách:']:\n        idx = cleaned.find(mk)\n        if idx != -1:\n            cleaned = cleaned[:idx]\n    cleaned = cleaned.strip(' .;')\n\n    low = cleaned.lower()\n\n    # Mẫu tóm tắt ưu tiên tiếng Việt, dễ đọc trên mobile\n    if 'hiding technical content' in low or 'ẩn nội dung kỹ thuật' in low:\n        return 'Anh Minh yêu cầu ẩn nội dung kỹ thuật mặc định và cho phép bấm xem thêm theo từng tin nhắn.'\n    if 'chat conversation in vietnamese' in low or 'hội thoại' in low:\n        return 'Đội bot cập nhật: phần trao đổi nội bộ đã chuyển sang dạng hội thoại tiếng Việt.'\n    if 'production hardening' in low or 'hardening' in low:\n        return 'Đội bot báo đã hoàn tất hardening bản dashboard và xác thực truy cập.'\n    if 'visual monitoring ui' in low or 'monitoring' in low:\n        return 'Anh Minh yêu cầu dashboard trực quan realtime để theo dõi tiến độ, lỗi và hiệu suất VPS.'\n    if 'hourly pm report' in low or 'báo cáo giờ' in low:\n        return 'MINH AI đã phát hành báo cáo giờ với trạng thái RAG và các rủi ro cần xử lý.'\n    if 'reports to be 100% vietnamese' in low or '100% vietnamese' in low:\n        return 'Anh Minh yêu cầu toàn bộ báo cáo hiển thị bằng tiếng Việt để dễ theo dõi.'\n    if 'internal scrum sync' in low or 'scrum sync' in low:\n        return 'Các bot đã đồng bộ nhanh, chốt đầu việc và mốc giờ thực thi trong phiên hiện tại.'\n\n    # Chuẩn hoá một số câu hội thoại tự nhiên\n    cleaned = cleaned.replace('Anh Minh hỏi', 'Anh Minh hỏi:')\n    cleaned = cleaned.replace('Anh Minh yêu cầu', 'Anh Minh yêu cầu:')\n    cleaned = cleaned.replace('Anh Minh đã phê duyệt', 'Anh Minh đã phê duyệt:')\n\n    # Nếu còn nhiều tiếng Anh thì thay bằng bản tóm tắt trung tính tiếng Việt\n    ascii_words = re.findall(r'[A-Za-z]{3,}', cleaned)\n    if len(ascii_words) >= 8:\n        return 'Cập nhật nội bộ: đội bot đang triển khai theo yêu cầu mới của anh Minh.'\n\n    if len(cleaned) < 12:\n        cleaned = 'Cập nhật công việc mới từ bot.'\n    return cleaned\n\n\ndef _extract_field(text: str, labels: list[str]) -> str:\n    points = []\n    all_labels = [\n        'Quyết định:', 'Phụ trách:', 'Vướng mắc:', 'Hạn dự kiến:', 'Bước tiếp theo:', 'Bằng chứng:',\n        'Decision:', 'Owners:', 'Owner:', 'Blockers:', 'ETA:', 'Next:', 'Evidence:'\n    ]\n    for lb in labels:\n        idx = text.find(lb)\n        if idx != -1:\n            start = idx + len(lb)\n            end = len(text)\n            for x in all_labels:\n                j = text.find(x, start)\n                if j != -1:\n                    end = min(end, j)\n            points.append(text[start:end].strip(' .;'))\n    return points[0] if points else ''\n\n[538 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1776069197502}}
{"type":"message","id":"6969a19b","parentId":"0f9a33a8","timestamp":"2026-04-13T08:33:17.510Z","message":{"role":"toolResult","toolCallId":"call_QdpcyVphXvm7pP4zxAKDrjns|","toolName":"read","content":[{"type":"text","text":"<!doctype html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>Ops Cockpit - Minh</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n  <style>\n    body{font-family:Inter,system-ui,Arial;background:#0b1020;color:#e9eefc;margin:0}\n    .wrap{padding:16px;max-width:1300px;margin:auto}\n    .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\n    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}\n    .card{background:#141b34;border:1px solid #263056;border-radius:12px;padding:12px}\n    .kpi{font-size:26px;font-weight:700}\n    .sub{color:#9fb0e3;font-size:12px}\n    .charts{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-top:12px}\n    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}\n    .rag-green{color:#67e8a5}.rag-amber{color:#f8c565}.rag-red{color:#ff6e6e}\n    ul{padding-left:18px;margin:8px 0}\n    .pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px}\n    .p-green{background:#1e3e2d}.p-amber{background:#4d3a14}.p-red{background:#4c2020}\n    table{width:100%;border-collapse:collapse;font-size:13px}\n    .msg{padding:10px;border-radius:10px;border:1px solid #2c3763;background:#111936}\n    .meta{font-size:12px;color:#a9b7e5;margin-bottom:4px}\n    .btn{margin-top:6px;background:#24335f;border:1px solid #3f5391;color:#dce6ff;padding:5px 8px;border-radius:8px;cursor:pointer;font-size:12px}\n    .detail{display:none;margin-top:8px;padding:8px;border-radius:8px;background:#0d1430;border:1px dashed #3b4a80;color:#d1dcff;white-space:pre-wrap}\n    .blk{padding:10px;border:1px solid #374067;border-radius:10px;background:#101733;margin-top:8px}\n    .sev-red{border-left:4px solid #ef4444}.sev-amber{border-left:4px solid #f59e0b}\n    th,td{padding:6px;border-bottom:1px solid #2a355f;text-align:left}\n  </style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"top\">\n    <h2>🚀 Bảng điều hành vận hành thời gian thực</h2>\n    <div id=\"ts\" class=\"sub\"></div>\n  </div>\n\n  <div class=\"card\" style=\"margin-bottom:12px\">\n    <h4>🎙️ Hội thoại giọng nói với MINH AI</h4>\n    <div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center\">\n      <button class=\"btn\" id=\"voiceBtn\" onclick=\"toggleVoice()\">Bắt đầu hội thoại</button>\n      <button class=\"btn\" id=\"speakBtn\" onclick=\"startTalk()\">Giữ để nói</button>\n      <span class=\"sub\" id=\"voiceState\">Trạng thái: chưa bật</span>\n    </div>\n    <div style=\"margin-top:8px\">\n      <input id=\"voiceText\" placeholder=\"Hoặc gõ nhanh nội dung cho MINH AI...\" style=\"width:100%;padding:8px;border-radius:8px;border:1px solid #374067;background:#0d1430;color:#e9eefc\" />\n      <div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:8px\">\n        <button class=\"btn\" onclick=\"sendTyped()\">Gửi MINH AI</button>\n        <button class=\"btn\" onclick=\"pickImage()\">Đính kèm ảnh</button>\n        <button class=\"btn\" onclick=\"captureImage()\">Chụp ảnh</button>\n      </div>\n      <input type=\"file\" id=\"imgPicker\" accept=\"image/*\" style=\"display:none\" onchange=\"uploadPickedImage(event)\" />\n      <video id=\"camPreview\" autoplay playsinline style=\"display:none;width:280px;margin-top:8px;border-radius:8px;border:1px solid #374067\"></video>\n      <canvas id=\"camCanvas\" style=\"display:none\"></canvas>\n    </div>\n    <div id=\"voiceTranscript\" class=\"detail\" style=\"display:block;margin-top:8px\"></div>\n  </div>\n\n  <div class=\"grid\">\n    <div class=\"card\"><div class=\"sub\">CPU</div><div id=\"cpu\" class=\"kpi\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">RAM đang dùng</div><div id=\"ram\" class=\"kpi\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">Token hôm nay</div><div id=\"tok\" class=\"kpi\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">Điểm nghẽn</div><div id=\"blk\" class=\"kpi\">-</div></div>\n  </div>\n\n  <div class=\"grid\" style=\"margin-top:12px\">\n    <div class=\"card\"><div class=\"sub\">Hạn mức token còn lại</div><div id=\"tokRemainPct\" class=\"kpi\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">Token còn lại (ngày)</div><div id=\"tokRemainAbs\" class=\"kpi\" style=\"font-size:22px\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">Chi phí ước tính (VND)</div><div id=\"costVnd\" class=\"kpi\" style=\"font-size:22px\">-</div></div>\n    <div class=\"card\"><div class=\"sub\">Chi phí ước tính (USD)</div><div id=\"costUsd\" class=\"kpi\" style=\"font-size:22px\">-</div></div>\n  </div>\n\n  <div class=\"charts\">\n    <div class=\"card\"><canvas id=\"sysChart\" height=\"110\"></canvas></div>\n    <div class=\"card\">\n      <h4>Trạng thái dự án (RAG)</h4>\n      <div id=\"rag\"></div>\n      <canvas id=\"ownerChart\" height=\"180\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"row\">\n    <div class=\"card\">\n      <h4>Tiến trình tiêu thụ cao</h4>\n      <table><thead><tr><th>Tiến trình</th><th>CPU%</th><th>RAM%</th></tr></thead><tbody id=\"proc\"></tbody></table>\n    </div>\n    <div class=\"card\">\n      <h4>Cảnh báo & khuyến nghị</h4>\n      <ul id=\"recs\"></ul>\n    </div>\n  </div>\n\n  <div class=\"card\" style=\"margin-top:12px\" id=\"blockersCard\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px\">\n      <h4 style=\"margin:0\">🚨 Vướng mắc ưu tiên xử lý (từ tổng quan đến chi tiết)</h4>\n      <button class=\"btn\" id=\"toggleBlockersBtn\" onclick=\"toggleBlockers(this)\">Ẩn mục này</button>\n    </div>\n    <div id=\"blockers\"></div>\n  </div>\n\n  <div class=\"card\" style=\"margin-top:12px\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px\">\n      <h4 style=\"margin:0\">Trao đổi công việc / cập nhật gần nhất</h4>\n      <button class=\"btn\" id=\"toggleUpdatesBtn\" onclick=\"toggleUpdates(this)\">Ẩn mục này</button>\n    </div>\n    <ul id=\"updates\"></ul>\n  </div>\n\n  <div class=\"card\" style=\"margin-top:12px\">\n    <h4>💬 Hội thoại nội bộ giữa các bot (Tiếng Việt)</h4>\n    <div id=\"chat\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n  </div>\n</div>\n\n<script>\nconst history={t:[],cpu:[],ram:[],tok:[]};\nconst sysCtx=document.getElementById('sysChart');\nconst ownerCtx=document.getElementById('ownerChart');\nconst sysChart=new Chart(sysCtx,{type:'line',data:{labels:[],datasets:[\n  {label:'CPU %',data:[],borderColor:'#60a5fa'},\n  {label:'RAM %',data:[],borderColor:'#34d399'},\n  {label:'Đĩa %',data:[],borderColor:'#f59e0b'}\n]},options:{animation:false,responsive:true,scales:{y:{min:0,max:100}}}});\nlet ownerChart=null;\nlet recog=null;\nlet voiceEnabled=false;\nlet speaking=false;\nlet chatAttachments=[];\nlet camStream=null;\n\nfunction fmtBytes(n){const u=['B','KB','MB','GB','TB'];let i=0;while(n>1024&&i<u.length-1){n/=1024;i++;}return n.toFixed(1)+u[i]}\nfunction ragClass(r){return r==='RED'?'rag-red':(r==='AMBER'?'rag-amber':'rag-green')}\nfunction fmtNumber(n){return new Intl.NumberFormat('en-US').format(n||0)}\n\nfunction appendVoiceLine(role,text){\n  const box=document.getElementById('voiceTranscript');\n  const who = role==='assistant' ? 'MINH AI (nữ)' : 'Anh Minh';\n  box.innerHTML = `<div><b>${who}:</b> ${text}</div>` + box.innerHTML;\n}\n\nasync function askMinh(message){\n  const res = await fetch('/api/minh-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message, attachments: chatAttachments})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em xin lỗi anh, em chưa xử lý được yêu cầu này ạ.'); return; }\n  appendVoiceLine('assistant',data.reply);\n  speakText(data.reply);\n  chatAttachments=[];\n}\n\nasync function uploadBase64Image(imageData, source='upload'){\n  const res = await fetch('/api/upload-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({imageData, source})});\n  const data = await res.json();\n  if(!data.ok){ appendVoiceLine('assistant','Dạ em chưa nhận được ảnh hợp lệ ạ.'); return; }\n  chatAttachments.push({type:'image', url:data.url});\n  appendVoiceLine('user',`[Đã đính kèm ảnh] ${data.url}`);\n}\n\nfunction pickImage(){ document.getElementById('imgPicker').click(); }\n\nfunction uploadPickedImage(ev){\n  const f = ev.target.files && ev.target.files[0];\n  if(!f) return;\n  const rd = new FileReader();\n  rd.onload = ()=> uploadBase64Image(rd.result, 'picker');\n  rd.readAsDataURL(f);\n  ev.target.value='';\n}\n\nasync function captureImage(){\n  const video=document.getElementById('camPreview');\n  const canvas=document.getElementById('camCanvas');\n\n  if(!camStream){\n    try{\n      camStream = await navigator.mediaDevices.getUserMedia({video:true});\n      video.srcObject = camStream;\n      video.style.display='block';\n      appendVoiceLine('assistant','Dạ em đã bật camera. Anh bấm lại nút Chụp ảnh để chụp ạ.');\n      return;\n    }catch(e){\n      appendVoiceLine('assistant','Dạ em không mở được camera, anh kiểm tra quyền truy cập giúp em ạ.');\n      return;\n    }\n  }\n\n  const w = video.videoWidth || 640;\n  const h = video.videoHeight || 480;\n  canvas.width=w; canvas.height=h;\n  const ctx=canvas.getContext('2d');\n  ctx.drawImage(video,0,0,w,h);\n  const dataUrl = canvas.toDataURL('image/png');\n  await uploadBase64Image(dataUrl, 'camera');\n}\n\nfunction speakText(text){\n  const u = new SpeechSynthesisUtterance(text);\n  u.lang='vi-VN';\n  u.rate=1.0; u.pitch=1.15;\n  const voices = speechSynthesis.getVoices();\n  const v = voices.find(x=>x.lang && x.lang.toLowerCase().startsWith('vi') && /female|nữ/i.test(x.name)) || voices.find(x=>x.lang && x.lang.toLowerCase().startsWith('vi'));\n  if(v) u.voice=v;\n  speechSynthesis.speak(u);\n}\n\nfunction initRecognition(){\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n  if(!SR) return null;\n  const r = new SR();\n  r.lang='vi-VN';\n  r.continuous=false;\n  r.interimResults=false;\n  r.onresult = (e)=>{\n    const txt=e.results?.[0]?.[0]?.transcript||'';\n    if(txt){\n      appendVoiceLine('user',txt);\n      askMinh(txt);\n    }\n  };\n  r.onerror = ()=>{document.getElementById('voiceState').textContent='Trạng thái: lỗi nhận giọng nói';};\n  r.onend = ()=>{speaking=false; document.getElementById('voiceState').textContent= voiceEnabled ? 'Trạng thái: sẵn sàng nghe' : 'Trạng thái: chưa bật';};\n  return r;\n}\n\nfunction toggleVoice(){\n  voiceEnabled=!voiceEnabled;\n  document.getElementById('voiceBtn').textContent = voiceEnabled ? 'Tắt hội thoại' : 'Bắt đầu hội thoại';\n  document.getElementById('voiceState').textContent = voiceEnabled ? 'Trạng thái: sẵn sàng nghe' : 'Trạng thái: chưa bật';\n  if(voiceEnabled && !recog){recog=initRecognition();}\n}\n\nfunction startTalk(){\n  if(!voiceEnabled){toggleVoice();}\n  if(!recog){appendVoiceLine('assistant','Dạ trình duyệt chưa hỗ trợ nhận giọng nói ạ. Anh dùng ô nhập chữ giúp em nhé.');return;}\n  try{ speaking=true; document.getElementById('voiceState').textContent='Trạng thái: đang nghe...'; recog.start(); }catch(e){}\n}\n\nfunction sendTyped(){\n  const el=document.getElementById('voiceText');\n  const txt=(el.value||'').trim();\n  if(!txt) return;\n  appendVoiceLine('user',txt);\n  el.value='';\n  askMinh(txt);\n}\n\nasync function tick(){\n  const r=await fetch('/api/metrics');\n  const d=await r.json();\n  document.getElementById('ts').textContent='Cập nhật: '+new Date(d.timestamp).toLocaleString();\n  document.getElementById('cpu').textContent=d.system.cpuPercent+'%';\n  document.getElementById('ram').textContent=d.system.memory.usedPct+'%';\n  document.getElementById('tok').textContent=fmtNumber(d.projects.tokenToday.total);\n  document.getElementById('blk').textContent=d.projects.blockerCount;\n\n  const b=d.projects.tokenBudget||{};\n  const c=d.projects.costEstimate||{};\n  document.getElementById('tokRemainPct').textContent=(b.remainingPct??0)+'%';\n  document.getElementById('tokRemainAbs').textContent=fmtNumber(b.remaining||0);\n  document.getElementById('costVnd').textContent=fmtNumber(c.vnd||0)+' VND';\n  document.getElementById('costUsd').textContent=(c.usd??0).toFixed(4)+' USD';\n\n  const label=new Date().toLocaleTimeString();\n  sysChart.data.labels.push(label);\n  sysChart.data.datasets[0].data.push(d.system.cpuPercent);\n  sysChart.data.datasets[1].data.push(d.system.memory.usedPct);\n  sysChart.data.datasets[2].data.push(d.system.disk.usedPct);\n  if(sysChart.data.labels.length>30){\n    sysChart.data.labels.shift();\n    sysChart.data.datasets.forEach(x=>x.data.shift());\n  }\n  sysChart.update();\n\n  document.getElementById('rag').innerHTML=`\n    <div><span class=\"pill p-green\">GREEN ${d.projects.ragCounts.GREEN||0}</span>\n    <span class=\"pill p-amber\">AMBER ${d.projects.ragCounts.AMBER||0}</span>\n    <span class=\"pill p-red\">RED ${d.projects.ragCounts.RED||0}</span></div>`;\n\n  const owners=d.projects.ownerActivity;\n  const labels=Object.keys(owners), values=Object.values(owners);\n  if(!ownerChart){\n    ownerChart=new Chart(ownerCtx,{type:'bar',data:{labels,datasets:[{label:'Tần suất cập nhật theo người phụ trách',data:values,backgroundColor:'#8b5cf6'}]},options:{animation:false}})\n  }else{\n    ownerChart.data.labels=labels; ownerChart.data.datasets[0].data=values; ownerChart.update();\n  }\n\n  document.getElementById('proc').innerHTML=d.system.topProcesses.map(p=>`<tr><td>${p.name}</td><td>${p.cpu}</td><td>${p.mem}</td></tr>`).join('');\n  document.getElementById('recs').innerHTML=d.recommendations.map(x=>`<li>${x}</li>`).join('');\n\n  const pb=(d.projects.priorityBlockers||[]);\n  document.getElementById('blockers').innerHTML = pb.length\n    ? pb.map((b,i)=>`<div class=\"blk ${b.severity==='RED'?'sev-red':'sev-amber'}\"><div class=\"meta\"><b>[${b.severity}]</b> ${b.speaker} ${b.time?('· '+b.time):''}</div><div>${b.text}</div><button class=\"btn\" onclick=\"toggleDetail('pb${i}', this)\">Xem thêm bối cảnh</button><div class=\"detail\" id=\"pb${i}\">Nguồn: ${b.source}\\nChi tiết ghi nhận: ${b.raw||b.text}</div></div>`).join('')\n    : '<div class=\"sub\">Hiện chưa có vướng mắc ưu tiên cần xử lý.</div>';\n  const updatesLight=(d.projects.updatesLight||[]).slice(-12).reverse();\n  document.getElementById('updates').innerHTML=updatesLight.map(u=>`<li class=\"${ragClass(u.rag)}\">[${u.rag}] ${u.time?u.time+': ':''}${u.text}</li>`).join('');\n\n  const chat=(d.projects.chat||[]).slice(-14).reverse();\n  document.getElementById('chat').innerHTML=chat.map((c,i)=>`<div class=\"msg\"><div class=\"meta\">${c.speaker} ${c.time?('· '+c.time):''} <span class=\"${ragClass(c.rag)}\">[${c.rag}]</span></div><div>${c.text}</div><button class=\"btn\" onclick=\"toggleDetail('d${i}', this)\">Xem thêm chi tiết kỹ thuật</button><div class=\"detail\" id=\"d${i}\">${c.detail||'Không có chi tiết.'}</div></div>`).join('');\n}\n\nfunction toggleDetail(id, btn){\n  const el=document.getElementById(id);\n  if(!el) return;\n  const open = el.style.display==='block';\n  el.style.display = open ? 'none' : 'block';\n  if(btn){ btn.textContent = open ? 'Xem thêm chi tiết kỹ thuật' : 'Ẩn chi tiết kỹ thuật'; }\n}\n\nfunction toggleUpdates(btn){\n  const el=document.getElementById('updates');\n  if(!el) return;\n  const open = el.style.display !== 'none';\n  el.style.display = open ? 'none' : 'block';\n  btn.textContent = open ? 'Hiện mục này' : 'Ẩn mục này';\n}\n\nfunction toggleBlockers(btn){\n  const el=document.getElementById('blockers');\n  if(!el) return;\n  const open = el.style.display !== 'none';\n\n[9 more lines in file. Use offset=321 to continue.]"}],"isError":false,"timestamp":1776069197507}}
