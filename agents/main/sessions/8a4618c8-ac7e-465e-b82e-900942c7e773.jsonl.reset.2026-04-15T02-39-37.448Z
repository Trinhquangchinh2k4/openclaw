ackground:#f6f6f6}\n    .muted{color:#666}\n  </style>\n</head>\n<body>\n  <h2>Realtime tiến độ điền file ngân hàng (A/B/C)</h2>\n  <p class=\"muted\">Tự làm mới mỗi 10 giây.</p>\n  <div class=\"kpi\" id=\"kpi\"></div>\n  <p id=\"time\" class=\"muted\"></p>\n  <p>\n    <a id=\"wip\" href=\"#\" target=\"_blank\">Mở file WIP đang làm</a> |\n    <a id=\"snap\" href=\"#\" target=\"_blank\">Mở file snapshot gần nhất</a>\n  </p>\n  <table>\n    <thead><tr><th>Code</th><th>Bank</th><th>A</th><th>B</th><th>C</th><th>Owner</th><th>Ghi chú</th></tr></thead>\n    <tbody id=\"rows\"></tbody>\n  </table>\n  <script>\n    async function load(){\n      const r=await fetch('/uploads/realtime-progress.json?ts='+Date.now());\n      const d=await r.json();\n      document.getElementById('time').textContent='Updated UTC: '+d.updated_at_utc+' | RAG: '+d.overall.rag;\n      document.getElementById('kpi').innerHTML=`\n        <div class=\"card\"><b>Source files</b><div>${d.overall.source_files}</div></div>\n        <div class=\"card\"><b>Bank có source</b><div>${d.overall.unique_banks_with_source}/${d.overall.target_banks}</div></div>\n        <div class=\"card\"><b>Bank C=DONE</b><div>${d.overall.banks_filled_C_done}/${d.overall.target_banks}</div></div>\n      `;\n      document.getElementById('wip').href=d.files.wip_excel;\n      document.getElementById('snap').href=d.files.latest_snapshot_excel;\n      document.getElementById('rows').innerHTML=d.banks.map(b=>`<tr><td>${b.code}</td><td>${b.bank}</td><td>${b.A_source}</td><td>${b.B_parsed}</td><td>${b.C_filled}</td><td>${b.owner}</td><td>${b.note}</td></tr>`).join('');\n    }\n    load(); setInterval(load,10000);\n  </script>\n</body>\n</html>\n"},"partialJson":"{\"path\":\"/home/openclaw_user/.openclaw/workspace/ops_cockpit/uploads/realtime-progress.html\",\"content\":\"<!doctype html>\\n<html lang=\\\"vi\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n  <title>Realtime tiến độ điền template</title>\\n  <style>\\n    body{font-family:Arial,sans-serif;max-width:980px;margin:20px auto;padding:0 12px}\\n    .kpi{display:flex;gap:12px;flex-wrap:wrap}\\n    .card{border:1px solid #ddd;border-radius:8px;padding:10px 12px;min-width:160px}\\n    table{width:100%;border-collapse:collapse;margin-top:12px}\\n    th,td{border:1px solid #ddd;padding:8px;font-size:14px}\\n    th{background:#f6f6f6}\\n    .muted{color:#666}\\n  </style>\\n</head>\\n<body>\\n  <h2>Realtime tiến độ điền file ngân hàng (A/B/C)</h2>\\n  <p class=\\\"muted\\\">Tự làm mới mỗi 10 giây.</p>\\n  <div class=\\\"kpi\\\" id=\\\"kpi\\\"></div>\\n  <p id=\\\"time\\\" class=\\\"muted\\\"></p>\\n  <p>\\n    <a id=\\\"wip\\\" href=\\\"#\\\" target=\\\"_blank\\\">Mở file WIP đang làm</a> |\\n    <a id=\\\"snap\\\" href=\\\"#\\\" target=\\\"_blank\\\">Mở file snapshot gần nhất</a>\\n  </p>\\n  <table>\\n    <thead><tr><th>Code</th><th>Bank</th><th>A</th><th>B</th><th>C</th><th>Owner</th><th>Ghi chú</th></tr></thead>\\n    <tbody id=\\\"rows\\\"></tbody>\\n  </table>\\n  <script>\\n    async function load(){\\n      const r=await fetch('/uploads/realtime-progress.json?ts='+Date.now());\\n      const d=await r.json();\\n      document.getElementById('time').textContent='Updated UTC: '+d.updated_at_utc+' | RAG: '+d.overall.rag;\\n      document.getElementById('kpi').innerHTML=`\\n        <div class=\\\"card\\\"><b>Source files</b><div>${d.overall.source_files}</div></div>\\n        <div class=\\\"card\\\"><b>Bank có source</b><div>${d.overall.unique_banks_with_source}/${d.overall.target_banks}</div></div>\\n        <div class=\\\"card\\\"><b>Bank C=DONE</b><div>${d.overall.banks_filled_C_done}/${d.overall.target_banks}</div></div>\\n      `;\\n      document.getElementById('wip').href=d.files.wip_excel;\\n      document.getElementById('snap').href=d.files.latest_snapshot_excel;\\n      document.getElementById('rows').innerHTML=d.banks.map(b=>`<tr><td>${b.code}<