{"type":"message","id":"50ae490c","parentId":"668c3f76","timestamp":"2026-04-13T08:33:30.466Z","message":{"role":"toolResult","toolCallId":"call_qdWC5LGZu17tmynRlVTpc7vU|","toolName":"read","content":[{"type":"text","text":"        out = subprocess.check_output(\n            \"ps -eo comm,%cpu,%mem --sort=-%cpu | head -n 8\",\n            shell=True,\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n        rows = []\n        for ln in out.splitlines()[1:]:\n            parts = ln.split()\n            if len(parts) >= 3:\n                rows.append({'name': parts[0], 'cpu': float(parts[1]), 'mem': float(parts[2])})\n        return rows\n    except Exception:\n        return []\n\n\ndef build_payload():\n    now = datetime.now(timezone.utc).isoformat()\n    cpu = cpu_usage_percent()\n    load1, load5, load15 = os.getloadavg()\n    mem = mem_info()\n\n    mem_total = mem.get('MemTotal', 0)\n    mem_avail = mem.get('MemAvailable', 0)\n    mem_used = max(mem_total - mem_avail, 0)\n    mem_pct = round((mem_used / mem_total * 100), 1) if mem_total else 0\n\n    swap_total = mem.get('SwapTotal', 0)\n    swap_free = mem.get('SwapFree', 0)\n    swap_used = max(swap_total - swap_free, 0)\n    swap_pct = round((swap_used / swap_total * 100), 1) if swap_total else 0\n\n    disk = shutil.disk_usage('/')\n    disk_pct = round((disk.used / disk.total * 100), 1)\n\n    tokens = token_stats_today()\n    updates = parse_team_updates()\n    owners = owner_activity(updates)\n\n    rag_counts = {'GREEN': 0, 'AMBER': 0, 'RED': 0}\n    for u in updates:\n        rag_counts[u['rag']] = rag_counts.get(u['rag'], 0) + 1\n\n    priority_blockers = parse_priority_blockers(updates, limit=8)\n    blocker_count = len(priority_blockers)\n\n    est_usd = (tokens['in'] / 1_000_000.0) * IN_USD_PER_1M + (tokens['out'] / 1_000_000.0) * OUT_USD_PER_1M\n    est_vnd = int(round(est_usd * USD_TO_VND))\n    budget_remaining = max(TOKEN_BUDGET_DAILY - tokens['total'], 0)\n    budget_remaining_pct = round((budget_remaining / TOKEN_BUDGET_DAILY) * 100, 1) if TOKEN_BUDGET_DAILY > 0 else 0.0\n\n    recs = []\n    if cpu > 80:\n        recs.append('CPU cao >80%: kiểm tra tiến trình tiêu tốn CPU và cân nhắc scale.')\n    if mem_pct > 85:\n        recs.append('RAM >85%: theo dõi memory leak, tăng swap hoặc nâng RAM.')\n    if disk_pct > 80:\n        recs.append('Disk >80%: cần dọn log/artifact hoặc mở rộng volume.')\n    if load1 > os.cpu_count():\n        recs.append('Load 1m vượt số core: có nguy cơ nghẽn xử lý.')\n    if blocker_count > 0:\n        recs.append(f'Có {blocker_count} vướng mắc ưu tiên trong log gần nhất: cần quyết định sớm.')\n    if budget_remaining_pct < 20:\n        recs.append(f'Hạn mức token còn {budget_remaining_pct}%: cần theo dõi để tránh vượt ngân sách trong ngày.')\n    if not recs:\n        recs.append('Hệ thống ổn định. Duy trì theo dõi realtime mỗi 5 giây.')\n\n    chat = build_chat_messages(updates, limit=24)\n\n    return {\n        'timestamp': now,\n        'voiceProfile': {\n            'name': 'MINH AI nữ',\n            'lang': 'vi-VN',\n            'style': 'ngoan ngoãn'\n        },\n        'system': {\n            'cpuPercent': cpu,\n            'load': {'l1': round(load1, 2), 'l5': round(load5, 2), 'l15': round(load15, 2)},\n            'memory': {'total': mem_total, 'used': mem_used, 'available': mem_avail, 'usedPct': mem_pct},\n            'swap': {'total': swap_total, 'used': swap_used, 'free': swap_free, 'usedPct': swap_pct},\n            'disk': {'total': disk.total, 'used': disk.used, 'free': disk.free, 'usedPct': disk_pct},\n            'topProcesses': top_processes(),\n        },\n        'projects': {\n            'tokenToday': tokens,\n            'tokenBudget': {\n                'daily': TOKEN_BUDGET_DAILY,\n                'used': tokens['total'],\n                'remaining': budget_remaining,\n                'remainingPct': budget_remaining_pct,\n            },\n            'costEstimate': {\n                'usd': round(est_usd, 4),\n                'vnd': est_vnd,\n                'fxUsdToVnd': USD_TO_VND,\n                'rateInUsdPer1M': IN_USD_PER_1M,\n                'rateOutUsdPer1M': OUT_USD_PER_1M,\n            },\n            'ragCounts': rag_counts,\n            'blockerCount': blocker_count,\n            'priorityBlockers': priority_blockers,\n            'updates': updates,\n            'updatesLight': chat,\n            'chat': chat,\n            'ownerActivity': owners,\n        },\n        'recommendations': recs,\n    }\n\n\ndef save_base64_image(image_data: str, prefix: str = 'upload'):\n    try:\n        m = re.match(r'^data:image/(png|jpeg|jpg|webp);base64,(.+)$', image_data, re.IGNORECASE)\n        if not m:\n            return None\n        ext = m.group(1).lower().replace('jpeg', 'jpg')\n        raw = base64.b64decode(m.group(2))\n        ts = datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S-%f')\n        name = f\"{prefix}-{ts}.{ext}\"\n        p = UPLOAD_DIR / name\n        p.write_bytes(raw)\n        return name\n    except Exception:\n        return None\n\n\ndef generate_minh_reply(user_text: str, attachments=None):\n    q = (user_text or '').strip()\n    q_low = q.lower()\n    data = build_payload()\n\n    token = data['projects']['tokenToday']['total']\n    remain_pct = data['projects']['tokenBudget']['remainingPct']\n    vnd = data['projects']['costEstimate']['vnd']\n    cpu = data['system']['cpuPercent']\n    ram = data['system']['memory']['usedPct']\n    blockers = data['projects']['blockerCount']\n\n    def fnum(n):\n        return f\"{int(n):,}\"\n\n    if attachments:\n        return 'Dạ anh Minh, em đã nhận hình ảnh đính kèm. Anh muốn em phân tích nhanh nội dung hay trích xuất điểm cần xử lý ạ?'\n\n    if any(k in q_low for k in ['chào', 'hello', 'hi']):\n        return 'Dạ em chào anh Minh ạ. Em luôn sẵn sàng hỗ trợ anh.'\n    if any(k in q_low for k in ['token', 'hạn mức', 'chi phí']):\n        return f\"Dạ anh Minh, hôm nay đã dùng {fnum(token)} token, còn {remain_pct}%, chi phí ước tính {fnum(vnd)} VND ạ.\"\n    if any(k in q_low for k in ['blocker', 'vướng mắc', 'nghẽn']):\n        return f\"Dạ anh Minh, hiện có {blockers} vướng mắc ưu tiên. Anh có thể mở mục ‘Vướng mắc ưu tiên xử lý’ để xem từng điểm và bối cảnh chi tiết ạ.\"\n    if any(k in q_low for k in ['hiệu suất', 'vps', 'cpu', 'ram', 'tải']):\n        return f\"Dạ anh Minh, hiện CPU khoảng {cpu}%, RAM dùng khoảng {ram}%. Hệ thống đang vận hành ổn định ạ.\"\n\n    return 'Dạ anh Minh, em đã nhận yêu cầu. Anh nói rõ thêm mục tiêu hoặc quyết định cần em hỗ trợ để em xử lý ngay ạ.'\n\n\nclass Handler(BaseHTTPRequestHandler):\n    def _is_authorized(self):\n        # Nếu không set password thì tạm thời mở (phục vụ local dev)\n        if not AUTH_PASS:\n            return True\n        auth = self.headers.get('Authorization', '')\n        if not auth.startswith('Basic '):\n            return False\n        try:\n            raw = base64.b64decode(auth.split(' ', 1)[1]).decode('utf-8', errors='ignore')\n            user, pw = raw.split(':', 1)\n            return user == AUTH_USER and pw == AUTH_PASS\n        except Exception:\n            return False\n\n    def _deny(self):\n        self.send_response(401)\n        self.send_header('WWW-Authenticate', 'Basic realm=\"Ops Cockpit\"')\n        self.end_headers()\n\n    def _json(self, data, code=200):\n        b = json.dumps(data, ensure_ascii=False).encode('utf-8')\n        self.send_response(code)\n        self.send_header('Content-Type', 'application/json; charset=utf-8')\n        self.send_header('Cache-Control', 'no-store')\n        self.send_header('Content-Length', str(len(b)))\n        self.end_headers()\n        self.wfile.write(b)\n\n    def do_POST(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if not self._is_authorized():\n            return self._deny()\n\n        if path == '/api/upload-image':\n            try:\n                length = int(self.headers.get('Content-Length', '0'))\n                raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n                body = json.loads(raw or '{}')\n                image_data = body.get('imageData') or ''\n                source = body.get('source') or 'upload'\n                saved = save_base64_image(image_data, prefix=source)\n                if not saved:\n                    return self._json({'ok': False, 'error': 'Dữ liệu ảnh không hợp lệ'}, code=400)\n                url = f\"/uploads/{saved}\"\n                return self._json({'ok': True, 'file': saved, 'url': url})\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        if path == '/api/minh-chat':\n            try:\n                length = int(self.headers.get('Content-Length', '0'))\n                raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n                body = json.loads(raw or '{}')\n                msg = (body.get('message') or '').strip()\n                attachments = body.get('attachments') or []\n                reply = generate_minh_reply(msg, attachments=attachments)\n                CHAT_MEMORY.append({'role': 'user', 'text': msg, 'attachments': attachments, 'ts': datetime.now(timezone.utc).isoformat()})\n                CHAT_MEMORY.append({'role': 'assistant', 'text': reply, 'attachments': [], 'ts': datetime.now(timezone.utc).isoformat()})\n                if len(CHAT_MEMORY) > 60:\n                    del CHAT_MEMORY[:-60]\n                return self._json({'ok': True, 'reply': reply, 'voice': {'lang': 'vi-VN', 'gender': 'female'}, 'memorySize': len(CHAT_MEMORY), 'history': CHAT_MEMORY[-20:]})\n            except Exception as e:\n                return self._json({'ok': False, 'error': str(e)}, code=400)\n\n        self.send_response(404)\n        self.end_headers()\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == '/health':\n            return self._json({'ok': True, 'time': datetime.now(timezone.utc).isoformat()})\n\n        if not self._is_authorized():\n            return self._deny()\n\n        if path == '/api/metrics':\n            return self._json(build_payload())\n\n        if path == '/api/chat-history':\n            return self._json({'ok': True, 'history': CHAT_MEMORY[-40:]})\n\n        if path.startswith('/uploads/'):\n            fp = UPLOAD_DIR / path.replace('/uploads/', '', 1)\n            if fp.exists() and fp.is_file() and str(fp.resolve()).startswith(str(UPLOAD_DIR.resolve())):\n                ext = fp.suffix.lower()\n                ctype = 'application/octet-stream'\n                if ext == '.png':\n                    ctype = 'image/png'\n                elif ext in ('.jpg', '.jpeg'):\n                    ctype = 'image/jpeg'\n                elif ext == '.webp':\n                    ctype = 'image/webp'\n                content = fp.read_bytes()\n                self.send_response(200)\n                self.send_header('Content-Type', ctype)\n                self.send_header('Content-Length', str(len(content)))\n                self.end_headers()\n                self.wfile.write(content)\n                return\n\n        # static files\n        file_path = PUBLIC_DIR / ('index.html' if path == '/' else path.lstrip('/'))\n        if file_path.exists() and file_path.is_file() and str(file_path.resolve()).startswith(str(PUBLIC_DIR.resolve())):\n            ctype = 'text/html; charset=utf-8'\n            if file_path.suffix == '.js':\n                ctype = 'application/javascript; charset=utf-8'\n            elif file_path.suffix == '.css':\n                ctype = 'text/css; charset=utf-8'\n            content = file_path.read_bytes()\n            self.send_response(200)\n            self.send_header('Content-Type', ctype)\n            self.send_header('Content-Length', str(len(content)))\n            self.end_headers()\n            self.wfile.write(content)\n            return\n\n        self.send_response(404)\n        self.end_headers()\n\n\nif __name__ == '__main__':\n    port = int(os.environ.get('OPS_COCKPIT_PORT', '18888'))\n    use_tls = os.environ.get('OPS_COCKPIT_TLS', '0') == '1'\n    cert_path = os.environ.get('OPS_COCKPIT_TLS_CERT', '/etc/ssl/ops-cockpit/cert.pem')\n    key_path = os.environ.get('OPS_COCKPIT_TLS_KEY', '/etc/ssl/ops-cockpit/key.pem')\n\n    server = ThreadingHTTPServer(('0.0.0.0', port), Handler)\n    if use_tls:\n        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\n        ctx.load_cert_chain(certfile=cert_path, keyfile=key_path)\n        server.socket = ctx.wrap_socket(server.socket, server_side=True)\n        print(f'Ops Cockpit HTTPS running on :{port}')\n    else:\n        print(f'Ops Cockpit HTTP running on :{port}')\n\n    server.serve_forever()\n"}],"isError":false,"timestamp":1776069210462}}
