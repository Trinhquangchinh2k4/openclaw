_low for k in ['chào', 'hello', 'hi']):\n 625         return 'Dạ em chào anh Minh ạ. Em luôn sẵn sàng hỗ trợ anh.'\n 626     if any(k in q_low for k in ['token', 'hạn mức', 'chi phí']):\n 627         return f\"Dạ anh Minh, hôm nay đã dùng {fnum(token)} token, còn {remain_pct}%, chi phí ước tính {fnum(vnd)} VND ạ.\"\n     ...\n 668 \n 669         if not self._is_authorized():\n 670             return self._deny()\n 671 \n+693         if path == '/api/upload-image':\n+694             try:\n+695                 length = int(self.headers.get('Content-Length', '0'))\n+696                 raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n+697                 body = json.loads(raw or '{}')\n+698                 image_data = body.get('imageData') or ''\n+699                 source = body.get('source') or 'upload'\n+700                 saved = save_base64_image(image_data, prefix=source)\n+701                 if not saved:\n+702                     return self._json({'ok': False, 'error': 'Dữ liệu ảnh không hợp lệ'}, code=400)\n+703                 url = f\"/uploads/{saved}\"\n+704                 return self._json({'ok': True, 'file': saved, 'url': url})\n+705             except Exception as e:\n+706                 return self._json({'ok': False, 'error': str(e)}, code=400)\n+707 \n 672         if path == '/api/minh-chat':\n 673             try:\n 674                 length = int(self.headers.get('Content-Length', '0'))\n 675                 raw = self.rfile.read(length).decode('utf-8', errors='ignore') if length > 0 else '{}'\n 676                 body = json.loads(raw or '{}')\n 677                 msg = (body.get('message') or '').strip()\n-678                 reply = generate_minh_reply(msg)\n-679                 CHAT_MEMORY.append({'user': msg, 'assistant': reply, 'ts': datetime.now(timezone.utc).isoformat()})\n-680                 if len(CHAT_MEMORY) > 30:\n-681                     del CHAT_MEMORY[:-30]\n-682                 return self._json({'ok': True, 'reply': reply, 'voice': {'lang': 'vi-VN', 'gender': 'female'}, 'memorySize': len(CHAT_MEMORY)})\n+714                 attachments = body.get('attachments') or []\n+715                 reply = generate_minh_reply(msg, attachments=attachments)\n+716                 CHAT_MEMORY.append({'role': 'user', 'text': msg, 'attachments': attachments, 'ts': datetime.now(timezone.utc).isoformat()})\n+717                 CHAT_MEMORY.append({'role': 'assistant', 'text': reply, 'attachments': [], 'ts': datetime.now(timezone.utc).isoformat()})\n+718                 if len(CHAT_MEMORY) > 60:\n+719                     del CHAT_MEMORY[:-60]\n+720                 return self._json({'ok': True, 'reply': reply, 'voice': {'lang': 'vi-VN', 'gender': 'female'}, 'memorySize': len(CHAT_MEMORY), 'history': CHAT_MEMORY[-20:]})\n 683             except Exception as e:\n 684                 return self._json({'ok': False, 'error': str(e)}, code=400)\n 685 \n 686         self.send_response(404)\n     ...\n 698 \n 699         if path == '/api/metrics':\n 700             return self._json(build_payload())\n 701 \n+740         if path == '/api/chat-history':\n+741             return self._json({'ok': True, 'history': CHAT_MEMORY[-40:]})\n+742 \n+743         if path.startswith('/uploads/'):\n+744             fp = UPLOAD_DIR / path.replace('/uploads/', '', 1)\n+745             if fp.exists() and fp.is_file() and str(fp.resolve()).startswith(str(UPLOAD_DIR.resolve())):\n+746                 ext = fp.suffix.lower()\n+747                 ctype = 'application/octet-stream'\n+748                 if ext == '.png':\n+749                     ctype = 'image/png'\n+750                 elif ext in ('.jpg', '.jpeg'):\n+751                     ctype = 'image/jpeg'\n+752                 elif ext == '.webp':\n+753                     ctype = 'image/webp'\n+754                 content = fp.read_bytes()\n+755                 self.send_response(200)\n+756                 self.send_header('Conte